+/* Splits text into lines of at most columns characters, at spaces.
+ * Returns the number of lines written (at most maxLines). */
+int wrap(const char* src, char lines[][48], int maxLines, int columns) {
+  int n = 0;
+  while (*src && n < maxLines) {
+    int len = strlen(src);
+    int cut = len;
+    if (len > columns) {
+      cut = columns;
+      while (cut > 0 && src[cut] != ' ') {
+        cut--;
+      }
+      if (cut == 0) {
+        cut = columns;
+      }
+    }
+    if (cut > 47) {
+      cut = 47;
+    }
+    memcpy(lines[n], src, cut);
+    lines[n][cut] = 0;
+    n++;
+    src += cut;
+    while (*src == ' ') {
+      src++;
+    }
+  }
+  return n;
+}
+
+void paragraph(Band& b, const char* textValue, int x, int y, int columns,
+               KDColor c, int maxLines = 8, int lineHeight = 15) {
+  char lines[8][48];
+  int n = wrap(textValue, lines, maxLines < 8 ? maxLines : 8, columns);
+  for (int i = 0; i < n; i++) {
+    text(b, lines[i], x, y + i * lineHeight, c);
+  }
+}
