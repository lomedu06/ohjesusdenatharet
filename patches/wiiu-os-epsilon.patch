+    c.line([(66, 58), (66, 72)], 6, fill=p)
+    c.line([(60, 64), (74, 64)], 4, fill=p)
+    c.line([(66, 72), (61, 84)], 4, fill=p)
+    c.line([(66, 72), (71, 84)], 4, fill=p)
