+bool wiiEvent(Event e) {
+  WiiModeState& w = s.wii;
+  if (w.phase == 0) {
+    if (e.isKeyboardEvent() && e != Events::OnOff) {
+      w.phase = 1;
+      invalidateAll();
+      return true;
+    }
+    return false;
+  }
+  if (w.phase == 1) {
+    int c = w.channel;
+    if (e == Events::Left && c % 4 > 0) {
+      c--;
+    } else if (e == Events::Right && c % 4 < 3) {
+      c++;
+    } else if (e == Events::Up && c >= 4) {
+      c -= 4;
+    } else if (e == Events::Down && c + 4 < k_channels) {
+      c += 4;
+    } else if ((e == Events::OK || e == Events::EXE) &&
+               k_channelNames[c][0]) {
+      w.phase = 2;
+      w.message = 0;
+    } else if (e == Events::Back || e == Events::Home) {
+      closeApplet();
+      return true;
+    } else {
+      return e.isKeyboardEvent() && e != Events::OnOff;
+    }
+    w.channel = c;
+    invalidateAll();
+    return true;
+  }
+  // Preview: "Menu Wii" goes back, "Démarrer" starts the channel
+  if (e == Events::Back) {
+    w.phase = 1;
+  } else if (e == Events::Left || e == Events::Right) {
+    // Only "Démarrer" is selectable once, "Menu Wii" after
+    w.message = w.message ? 0 : 2;
+  } else if (e == Events::OK || e == Events::EXE) {
+    if (w.message == 2) {
+      w.phase = 1;
+      w.message = 0;
+    } else if (w.channel == 1) {
+      openApplet(Applet::MiiMaker);
+      return true;
+    } else {
+      w.message = 1;
+    }
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
