+bool miiMakerEvent(Event e) {
+  MiiMakerState& st = s.miiMaker;
+  if (st.editing) {
+    int len = strlen(s.me.name);
+    if (e == Events::OK || e == Events::EXE || e == Events::Back) {
+      st.editing = false;
+      setAlphaLock(false);
+      if (len == 0) {
+        strlcpy(s.me.name, "Moi", Mii::k_nameSize);
+      }
+    } else if (e == Events::Backspace) {
+      if (len > 0) {
+        s.me.name[len - 1] = 0;
+      }
+    } else {
+      const char* t = e.text();
+      if (t && t[0] >= ' ' && t[0] < 127 && t[1] == 0 &&
+          len < Mii::k_nameSize - 1) {
+        s.me.name[len] = t[0];
+        s.me.name[len + 1] = 0;
+      } else {
+        return e.isKeyboardEvent() && e != Events::OnOff;
+      }
+    }
+    invalidateAll();
+    return true;
+  }
+  if (e == Events::Up && st.row > 0) {
+    st.row--;
+  } else if (e == Events::Down && st.row < k_miiRows - 1) {
+    st.row++;
+  } else if (e == Events::Left || e == Events::Right) {
+    int count;
+    uint8_t* field = miiField(st.row, &count);
+    if (field == nullptr) {
+      return true;
+    }
+    int d = e == Events::Left ? -1 : 1;
+    *field = static_cast<uint8_t>((*field + d + count) % count);
+  } else if (e == Events::OK || e == Events::EXE) {
+    if (st.row == 0) {
+      st.editing = true;
+      setAlphaLock(true);
+    } else if (st.row == k_miiRows - 1) {
+      char name[Mii::k_nameSize];
+      strlcpy(name, s.me.name, sizeof(name));
+      randomMii(&s.me, now() * 7 + random32());
+      strlcpy(s.me.name, name, sizeof(name));
+    }
+  } else if (e == Events::Back) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
