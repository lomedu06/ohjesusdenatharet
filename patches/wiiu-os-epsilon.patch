+void durationText(char* buffer, int size, uint32_t seconds) {
+  if (seconds < 60) {
+    fmt(buffer, size, "%d s", static_cast<int>(seconds));
+  } else if (seconds < 3600) {
+    fmt(buffer, size, "%d min", static_cast<int>(seconds / 60));
+  } else {
+    fmt(buffer, size, "%d h %02d", static_cast<int>(seconds / 3600),
+        static_cast<int>(seconds / 60 % 60));
+  }
+}
