+/* =========================================================== Drawing */
+
+bool drawingEvent(Event e) {
+  DrawingState& d = s.drawing;
+  int dx = 0, dy = 0;
+  if (e == Events::Left) {
+    dx = -1;
+  } else if (e == Events::Right) {
+    dx = 1;
+  } else if (e == Events::Up) {
+    dy = -1;
+  } else if (e == Events::Down) {
+    dy = 1;
+  }
+  if (dx || dy) {
+    int x = d.x + dx, y = d.y + dy;
+    if (x >= 0 && x < DrawingState::k_width && y >= 0 &&
+        y < DrawingState::k_height) {
+      d.x = x;
+      d.y = y;
+    }
+    if (d.pen) {
+      int r = d.eraser ? 2 : 0;
+      for (int j = -r; j <= r; j++) {
+        for (int i = -r; i <= r; i++) {
+          setDrawingPixel(d.x + i, d.y + j, !d.eraser);
+        }
+      }
+    }
+  } else if (e == Events::OK) {
+    d.pen = !d.pen;
+    if (d.pen) {
+      setDrawingPixel(d.x, d.y, !d.eraser);
+    }
+  } else if (e == Events::Backspace) {
+    d.eraser = !d.eraser;
+  } else if (e == Events::Var) {
+    memset(d.pixels, 0, sizeof(d.pixels));
+  } else if (e == Events::EXE) {
+    // Post it
+    d.hasPost = true;
+    d.pen = false;
+    insertPost({0xFF, k_communityDrawings, 0, 2, 0, false, 0});
+    s.miiverse.selected = 0;
+    addNotification(8, 0);
+    openApplet(Applet::Miiverse);
+    return true;
+  } else if (e == Events::Back) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidate({40, 36, 244, 140});
+  invalidate({0, 176, k_screenWidth, 42});
+  return true;
+}
+
+void drawingRender(Band& b) {
+  DrawingState& d = s.drawing;
+  vgradient(b, {0, k_top, k_screenWidth, k_bottom - k_top}, rgb(0xFFF6C8),
+            rgb(0xF7E08A));
+  Rect canvas = {40, 38, DrawingState::k_width * 2, DrawingState::k_height * 2};
+  shadow(b, canvas, 2, 60);
+  drawDrawing(b, canvas.x, canvas.y, 2, rgb(0xFFFDF2), rgb(0x2D2D2D));
+  frame(b, canvas.inset(-1), rgb(0xC9B060));
+  // Cursor
+  int cx = canvas.x + d.x * 2 + 1, cy = canvas.y + d.y * 2 + 1;
+  KDColor cc = d.pen ? (d.eraser ? rgb(0xE60012) : rgb(0xF07800))
+                     : rgb(0x2FA8E0);
+  fill(b, {cx - 6, cy, 4, 1}, cc);
+  fill(b, {cx + 3, cy, 4, 1}, cc);
+  fill(b, {cx, cy - 6, 1, 4}, cc);
+  fill(b, {cx, cy + 3, 1, 4}, cc);
+  if (d.eraser) {
+    frame(b, {cx - 5, cy - 5, 11, 11}, cc);
+  }
+  // Tools
+  Rect pen = {40, 180, 72, 20};
+  Rect eraser = {120, 180, 72, 20};
+  roundFill(b, pen, 10, !d.eraser ? rgb(0xF07800) : k_white);
+  roundFill(b, eraser, 10, d.eraser ? rgb(0xE60012) : k_white);
+  text(b, "Crayon", pen.x + 36, pen.y + 3, !d.eraser ? k_white : k_ink,
+       Small, Align::Center);
+  text(b, "Gomme", eraser.x + 36, eraser.y + 3, d.eraser ? k_white : k_ink,
+       Small, Align::Center);
+  text(b, d.pen ? "Pointe posée" : "Pointe levée", 206, 183, k_ink);
+  hintBar(b, "OK:crayon <x:gomme Var:effacer EXE:publier");
+}
