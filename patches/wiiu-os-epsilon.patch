+void shopRender(Band& b) {
+  ShopState& st = s.shop;
+  vgradient(b, {0, k_top, k_screenWidth, 26}, rgb(0xFFB81C), rgb(0xF09A00));
+  text(b, "Bienvenue !", 10, k_top + 6, k_white);
+  text(b, "Solde : 0,00 EUR", 310, k_top + 6, k_white, Small, Align::Right);
+  int first = st.selected > 3 ? st.selected - 3 : 0;
+  for (int k = 0; k < 4 && first + k < shopCount(); k++) {
+    int i = first + k;
+    Rect r = {6, k_top + 30 + k * 36, 308, 33};
