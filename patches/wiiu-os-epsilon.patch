+/* ===================================================== Activity log */
+
+int sortedActivity(int* order) {
+  ActivityState& a = s.activity;
+  int n = a.count;
+  for (int i = 0; i < n; i++) {
+    order[i] = i;
+  }
+  for (int i = 1; i < n; i++) {
+    int k = order[i];
+    int j = i - 1;
+    while (j >= 0 && (a.entries[order[j]].seconds < a.entries[k].seconds ||
+                      (a.entries[order[j]].seconds == a.entries[k].seconds &&
+                       a.entries[order[j]].launches < a.entries[k].launches))) {
+      order[j + 1] = order[j];
+      j--;
+    }
+    order[j + 1] = k;
+  }
+  return n;
+}
+
+bool activityEvent(Event e) {
+  ActivityState& a = s.activity;
+  if (e == Events::Up && a.scroll > 0) {
+    a.scroll--;
+  } else if (e == Events::Down && a.scroll + 5 < a.count) {
+    a.scroll++;
+  } else if (e == Events::Back || e == Events::OK) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
+
+void activityRender(Band& b) {
+  ActivityState& a = s.activity;
+  char buffer[48];
+  char d[16];
+  panel(b, {6, k_top + 4, 308, 40});
+  durationText(d, sizeof(d), a.totalSeconds);
+  fmt(buffer, sizeof(buffer), "Dans les applis : %s", d);
+  text(b, buffer, 14, k_top + 8, k_ink);
+  durationText(d, sizeof(d), a.menuSeconds);
+  fmt(buffer, sizeof(buffer), "Dans le menu Wii U : %s", d);
+  text(b, buffer, 14, k_top + 24, k_inkLight);
+  int order[ActivityState::k_entries];
+  int n = sortedActivity(order);
+  if (n == 0) {
+    paragraph(b,
+              "Aucune activité pour l'instant. Lance une appli ou un jeu : "
+              "le temps passé dedans sera noté ici.",
+              20, 100, 40, k_inkLight);
+  }
+  uint32_t max = 1;
+  for (int i = 0; i < n; i++) {
+    if (a.entries[order[i]].seconds > max) {
+      max = a.entries[order[i]].seconds;
+    }
+  }
+  for (int r = 0; r < 5 && a.scroll + r < n; r++) {
+    const ActivityEntry& e = a.entries[order[a.scroll + r]];
+    int y = k_top + 50 + r * 33;
+    panel(b, {6, y, 308, 30});
+    drawSlotArt(b, e.slot, 10, y + 3, 24);
+    text(b, slotLabel(e.slot), 40, y + 2, k_ink, Small, Align::Left, 130);
+    fmt(buffer, sizeof(buffer), "%d fois", e.launches);
+    text(b, buffer, 40, y + 15, k_inkLight);
+    int w = static_cast<int>(120 * e.seconds / max);
+    roundFill(b, {176, y + 9, 120, 12}, 4, rgb(0xE6EBEE));
+    roundFill(b, {176, y + 9, w < 4 ? 4 : w, 12}, 4, rgb(0x3CC23C));
+    durationText(d, sizeof(d), e.seconds);
+    text(b, d, 300, y + 8, k_ink, Small, Align::Right);
