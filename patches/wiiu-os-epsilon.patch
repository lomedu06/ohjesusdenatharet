+/* ========================================================== Miiverse */
+
+int postHeight(const Post& p) { return p.kind == 2 ? 98 : 58; }
+
+bool miiverseEvent(Event e) {
+  MiiverseState& m = s.miiverse;
+  if (e == Events::Up && m.selected > 0) {
+    m.selected--;
+  } else if (e == Events::Down && m.selected + 1 < m.count) {
+    m.selected++;
+  } else if (e == Events::OK || e == Events::EXE) {
+    Post& p = m.posts[m.selected];
+    p.yeahed = !p.yeahed;
+    p.yeahs += p.yeahed ? 1 : -1;
+  } else if (e == Events::Toolbox) {
+    openApplet(Applet::Drawing);
+    return true;
+  } else if (e == Events::Back) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
