+/* ================================================= Parental controls */
+
+constexpr int k_parentalRows = 6;
+
+bool parentalEvent(Event e) {
+  ParentalState& p = s.parental;
+  bool hasPin = p.pin[0] != 0;
+  int rows = hasPin ? k_parentalRows : 1;
+  if (e == Events::Up && p.row > 0) {
+    p.row--;
+  } else if (e == Events::Down && p.row < rows - 1) {
+    p.row++;
+  } else if (e == Events::OK || e == Events::EXE || e == Events::Left ||
+             e == Events::Right) {
+    if (!hasPin) {
+      Apps::askPin({Slot::Kind::Empty, 0}, false, 0);
+      p.newPin = true;
+    } else {
+      switch (p.row) {
+        case 0:
+          p.lockGames = !p.lockGames;
+          break;
+        case 1:
+          p.lockPython = !p.lockPython;
+          break;
+        case 2:
+          p.lockBrowser = !p.lockBrowser;
+          break;
+        case 3:
+          p.lockMiiverse = !p.lockMiiverse;
+          break;
+        case 4:
+          if (e == Events::OK || e == Events::EXE) {
+            Apps::askPin({Slot::Kind::Empty, 0}, false, 0);
+            p.newPin = true;
+          }
+          break;
+        case 5:
+          if (e == Events::OK || e == Events::EXE) {
+            p.pin[0] = 0;
+            p.lockGames = p.lockPython = p.lockBrowser = p.lockMiiverse =
+                false;
+            p.row = 0;
+          }
+          break;
+      }
+    }
+  } else if (e == Events::Back) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
