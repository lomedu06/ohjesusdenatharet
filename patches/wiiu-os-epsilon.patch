+
+bool browserEvent(Event e) {
+  BrowserState& st = s.browser;
+  if (st.page == 0) {
+    if (e == Events::Up && st.selected > 0) {
+      st.selected--;
+    } else if (e == Events::Down && st.selected + 1 < k_numberOfBookmarks) {
+      st.selected++;
+    } else if (e == Events::OK || e == Events::EXE) {
+      if (st.selected == 0) {
+        st.page = 3;
+        st.scroll = 0;
+      } else {
+        st.page = 1;
+        st.loadStart = now();
+      }
+    } else if (e == Events::Back) {
+      closeApplet();
+      return true;
+    } else {
+      return e.isKeyboardEvent() && e != Events::OnOff;
+    }
+  } else if (st.page == 3) {
+    if (e == Events::Up && st.scroll > 0) {
+      st.scroll--;
+    } else if (e == Events::Down && st.scroll + 11 < k_numberOfHelpLines) {
+      st.scroll++;
+    } else if (e == Events::Back || e == Events::OK) {
+      st.page = 0;
+    } else {
+      return e.isKeyboardEvent() && e != Events::OnOff;
+    }
+  } else {
+    if (e == Events::Back || e == Events::OK || e == Events::EXE) {
+      st.page = 0;
+    } else {
+      return e.isKeyboardEvent() && e != Events::OnOff;
+    }
+  }
+  invalidateAll();
+  return true;
+}
