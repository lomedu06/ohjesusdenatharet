+def art_sequence(c):
+    gradient_bg(c, 0x9A80FF, 0x6240E8)
+    for i in range(5):
+        c.circle(20 + i * 15, 76 - i * i * 2.6 - i * 4, 5.5)
+    c.text(32, 26, "un", 22)
+
+
+def art_regression(c):
+    gradient_bg(c, 0xFF4FA6, 0xD0006A)
+    for x, y in ((22, 70), (32, 66), (40, 56), (52, 54), (62, 42), (72, 38), (80, 26)):
+        c.circle(x, y, 4.5)
+    c.line([(14, 78), (88, 22)], 4, fill=hexc(0xFFFFFF, 190))
