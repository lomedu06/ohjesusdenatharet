+/* Wii U-OS: the Wii U menu on the NumWorks home screen.
+ *
+ * Boot ("Wii U" logo, then the Health and Safety screen), the menu (a grid of
+ * glossy tiles over several pages, your Mii at the top left, the bottom bar
+ * with Miiverse, friends, shop, browser, notifications, downloads and the TV
+ * button), moving tiles around, and the plumbing with the home app. The
+ * Wii U apps themselves are in apps.cpp. */
+
+#include "shell.h"
+
+#include <apps/apps_container.h>
+#include <apps/global_preferences.h>
+#include <apps/home/apps_layout.h>
+#include <apps/i18n.h>
+#include <ion.h>
+#include <ion/battery.h>
+#include <ion/led.h>
+#include <ion/timing.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "calc.h"
+#include "state.h"
+
+#if !PLATFORM_DEVICE
+#include <stdlib.h>
+#endif
+
+namespace Home {
+namespace WiiU {
+
+using Ion::Events::Event;
+namespace Events = Ion::Events;
+using KDFont::Size::Large;
+using KDFont::Size::Small;
+
+State s;
+
+namespace {
+
+void (*s_invalidator)(Rect) = nullptr;
+void (*s_painter)(Rect) = nullptr;
+// Loading screen (the app's icon) shown while a calculator app or game opens
+bool s_loading = false;
+Slot s_loadingSlot = {Slot::Kind::Empty, 0};
+Item s_launch = k_noItem;
+bool s_fakeClock = false;
+uint32_t s_fakeNow = 0;
+uint32_t s_lastTick = 0;
+int s_lastBattery = -1;
+bool s_lastCharging = false;
+uint8_t s_enterCount = 0;
+
+/* ---------------------------------------------------- calculator apps */
+
+struct BuiltinArt {
+  I18n::Message name;
+  uint8_t icon;
+};
+
+constexpr BuiltinArt k_builtinArt[] = {
+    {I18n::Message::CalculApp, WiiUIcons::IconCalculation},
+    {I18n::Message::FunctionApp, WiiUIcons::IconGraph},
+    {I18n::Message::SolverApp, WiiUIcons::IconSolver},
+    {I18n::Message::StatsApp, WiiUIcons::IconStatistics},
+    {I18n::Message::DistributionsApp, WiiUIcons::IconDistributions},
+    {I18n::Message::SequenceApp, WiiUIcons::IconSequence},
+    {I18n::Message::RegressionApp, WiiUIcons::IconRegression},
+    {I18n::Message::InferenceApp, WiiUIcons::IconInference},
+    {I18n::Message::FinanceApp, WiiUIcons::IconFinance},
+    {I18n::Message::CodeApp, WiiUIcons::IconCode},
+    {I18n::Message::ElementsApp, WiiUIcons::IconElements},
+    {I18n::Message::SettingsApp, WiiUIcons::IconCalcSettings},
+};
+
+constexpr int k_maxBuiltin = 20;
+int8_t s_builtin[k_maxBuiltin];  // app index in AppsContainer
+uint8_t s_builtinIcon[k_maxBuiltin];
+I18n::Message s_builtinName[k_maxBuiltin];
+int s_numberOfBuiltin = 0;
+int s_numberOfGames = 0;
+
+const Escher::App::Descriptor* builtinDescriptor(int appIndex) {
+  return AppsContainer::sharedAppsContainer()
+      ->appSnapshotAtIndex(PermutedAppSnapshotIndex(appIndex))
+      ->descriptor();
+}
+
+void listApps() {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfBuiltin = 0;
+  for (int i = 1; i < builtin && s_numberOfBuiltin < k_maxBuiltin; i++) {
+    I18n::Message name = builtinDescriptor(i)->name();
+    uint8_t icon = WiiUIcons::IconFolder;
+    for (const BuiltinArt& a : k_builtinArt) {
+      if (a.name == name) {
+        icon = a.icon;
+      }
+    }
+    s_builtin[s_numberOfBuiltin] = i;
+    s_builtinIcon[s_numberOfBuiltin] = icon;
+    s_builtinName[s_numberOfBuiltin] = name;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = container->numberOfApps() - builtin;
+  if (s_numberOfGames < 0) {
+    s_numberOfGames = 0;
+  }
+}
+
+int builtinSlotIndex(int appIndex) {
+  for (int i = 0; i < s_numberOfBuiltin; i++) {
+    if (s_builtin[i] == appIndex) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+Slot builtinNamed(I18n::Message name) {
+  for (int i = 0; i < s_numberOfBuiltin; i++) {
+    if (s_builtinName[i] == name) {
+      return {Slot::Kind::Builtin, s_builtin[i]};
+    }
+  }
+  return {Slot::Kind::Empty, 0};
+}
+
+Slot appletSlot(Applet a) {
+  return {Slot::Kind::Applet, static_cast<int8_t>(a)};
+}
+
+bool slotValid(Slot slot) {
+  switch (slot.kind) {
+    case Slot::Kind::Builtin:
+      return builtinSlotIndex(slot.index) >= 0;
+    case Slot::Kind::External:
+      return slot.index >= 0 && slot.index < s_numberOfGames;
+    case Slot::Kind::Applet:
+      return slot.index >= 0 && slot.index < k_numberOfApplets;
+    default:
+      return false;
+  }
+}
+
+int slotPosition(Slot slot) {
+  for (int i = 0; i < k_maxSlots; i++) {
+    if (s.slots[i] == slot) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+void placeInFirstEmpty(Slot slot) {
+  for (int i = 0; i < k_maxSlots; i++) {
+    if (s.slots[i].isEmpty()) {
+      s.slots[i] = slot;
+      return;
+    }
+  }
+}
+
+/* The menu as it is on a new console: a game first (like the disc), the
+ * calculator apps mixed with the Wii U apps, then the other games. */
+void defaultLayout() {
+  for (int i = 0; i < k_maxSlots; i++) {
+    s.slots[i] = {Slot::Kind::Empty, 0};
+  }
+  int n = 0;
+  auto add = [&n](Slot slot) {
+    if (n < k_maxSlots && !slot.isEmpty()) {
+      s.slots[n++] = slot;
+    }
+  };
+  if (s_numberOfGames > 0) {
+    add({Slot::Kind::External, 0});
+  }
+  add(builtinNamed(I18n::Message::CalculApp));
+  add(appletSlot(Applet::MiiMaker));
+  add(appletSlot(Applet::Settings));
+  add(builtinNamed(I18n::Message::FunctionApp));
+  add(builtinNamed(I18n::Message::SolverApp));
+  add(builtinNamed(I18n::Message::StatsApp));
+  add(builtinNamed(I18n::Message::DistributionsApp));
+  add(appletSlot(Applet::WiiMode));
+  add(appletSlot(Applet::Activity));
+  add(appletSlot(Applet::Parental));
+  add(appletSlot(Applet::Health));
+  add(appletSlot(Applet::Plaza));
+  add(appletSlot(Applet::Drawing));
+  add(builtinNamed(I18n::Message::SequenceApp));
+  add(builtinNamed(I18n::Message::RegressionApp));
+  add(builtinNamed(I18n::Message::InferenceApp));
+  add(builtinNamed(I18n::Message::FinanceApp));
+  add(builtinNamed(I18n::Message::CodeApp));
+  add(builtinNamed(I18n::Message::ElementsApp));
+  add(builtinNamed(I18n::Message::SettingsApp));
+  // Calculator apps this list does not know (other versions of Epsilon)
+  for (int i = 0; i < s_numberOfBuiltin; i++) {
+    Slot slot = {Slot::Kind::Builtin, s_builtin[i]};
+    bool known = false;
+    for (int k = 0; k < n; k++) {
+      known = known || s.slots[k] == slot;
+    }
+    if (!known) {
+      add(slot);
+    }
+  }
+  for (int g = 1; g < s_numberOfGames; g++) {
+    add({Slot::Kind::External, static_cast<int8_t>(g)});
+  }
+  s.gamesKnown = s_numberOfGames;
+}
+
+// Apps and games may have been added or removed since last time
+void reconcileLayout() {
+  for (int i = 0; i < k_maxSlots; i++) {
+    if (!s.slots[i].isEmpty() && !slotValid(s.slots[i])) {
+      s.slots[i] = {Slot::Kind::Empty, 0};
+    }
+  }
+  for (int i = 0; i < s_numberOfBuiltin; i++) {
+    Slot slot = {Slot::Kind::Builtin, s_builtin[i]};
+    if (slotPosition(slot) < 0) {
+      placeInFirstEmpty(slot);
+    }
+  }
+  for (int g = 0; g < s_numberOfGames; g++) {
+    Slot slot = {Slot::Kind::External, static_cast<int8_t>(g)};
+    if (slotPosition(slot) < 0) {
+      placeInFirstEmpty(slot);
+    }
+  }
+  for (int a = 0; a < k_numberOfApplets; a++) {
+    Applet applet = static_cast<Applet>(a);
+    // The dock apps are not tiles
+    bool tile = applet == Applet::MiiMaker || applet == Applet::Settings ||
+                applet == Applet::Activity || applet == Applet::Parental ||
+                applet == Applet::Health || applet == Applet::WiiMode ||
+                applet == Applet::Plaza || applet == Applet::Drawing;
+    if (tile && slotPosition(appletSlot(applet)) < 0) {
+      placeInFirstEmpty(appletSlot(applet));
+    }
+  }
+  s.gamesKnown = s_numberOfGames;
+}
+
+/* ------------------------------------------------------------ geometry */
+
+constexpr int k_tileSize = 44;
+constexpr int k_tileStepX = 52;
+constexpr int k_tileStepY = 50;
+constexpr int k_gridX = 34;
+constexpr int k_gridY = 34;
+constexpr int k_artSize = 36;
+constexpr int k_dockY = 208;
+constexpr int k_dockIcon = 24;
+constexpr int k_avatarSize = 28;
+constexpr Rect k_avatarRect = {4, 4, k_avatarSize, k_avatarSize};
+
+constexpr Applet k_dock[k_dockItems] = {
+    Applet::Miiverse, Applet::Friends,   Applet::Shop,  Applet::Browser,
+    Applet::Notifications, Applet::Downloads, Applet::Plaza};
+constexpr uint8_t k_dockIcons[k_dockItems] = {
+    WiiUIcons::IconMiiverse, WiiUIcons::IconFriends,
+    WiiUIcons::IconEShop,    WiiUIcons::IconBrowser,
+    WiiUIcons::IconNotifications, WiiUIcons::IconDownloads,
+    WiiUIcons::IconTV};
+
+int dockX(int i) { return 18 + i * 46; }
+
+int pageOf(int index) { return index / k_slotsPerPage; }
+int columnOf(int index) { return index % k_columns; }
+int rowOf(int index) { return (index % k_slotsPerPage) / k_columns; }
+
+int lastUsedPage() {
+  int last = 0;
+  for (int i = 0; i < k_maxSlots; i++) {
+    if (!s.slots[i].isEmpty()) {
+      last = pageOf(i);
+    }
+  }
+  return last;
+}
+
+int numberOfPages() {
+  int pages = lastUsedPage() + 1;
+  if (s.moving && pages < k_maxPages) {
+    pages++;
+  }
+  return pages < 2 ? 2 : pages;
+}
+
+int currentPage() { return pageOf(s.selected); }
+
+Rect tileRect(int index) {
+  float offset = (pageOf(index) - s.scroll) * k_screenWidth;
+  int x = k_gridX + columnOf(index) * k_tileStepX + static_cast<int>(offset);
+  int y = k_gridY + rowOf(index) * k_tileStepY;
+  return {x, y, k_tileSize, k_tileSize};
+}
+
+KDColor ink() {
+  return s.background == 2 ? rgb(0xE8ECF0) : rgb(0x4A4F55);
+}
+
+/* --------------------------------------------------------------- time */
+
+float pulse() {
+  float t = (now() % 1600) / 1600.f;
+  return 0.5f + 0.5f * sinf(t * 6.2831853f);
+}
+
+bool introRunning() { return now() - s.introStart < 700; }
+
+/* ------------------------------------------------------------- drawing */
+
+// The white glass tile of the Wii U menu, with its art inside
+void drawTile(Band& b, Rect r, Slot slot, int alpha, bool lifted) {
+  if (!r.inset(-6).intersects(b.clip())) {
+    return;
+  }
+  if (lifted) {
+    shadow(b, r.translated(2, 3), 8, 120);
+  } else {
+    shadow(b, r, 8, 50);
+  }
+  roundFill(b, r, 8, rgb(0xFFFFFF), alpha);
+  // Glass: a slightly darker lower half, light border
+  roundFill(b, {r.x + 1, r.y + r.h / 2, r.w - 2, r.h / 2 - 1}, 7,
+            rgb(0xEEF1F3), alpha);
+  roundFrame(b, r, 8, rgb(0xD3D8DC), alpha);
+  int art = r.w * k_artSize / k_tileSize;
+  int ax = r.x + (r.w - art) / 2;
+  int ay = r.y + (r.h - art) / 2;
+  if (!slot.isEmpty()) {
+    drawSlotArt(b, slot, ax, ay, art, alpha);
+    if (Apps::slotLocked(slot) && s.parental.pin[0] != 0) {
+      disc(b, r.right() - 7, r.y + 7, 7, rgb(0xEE3E9A));
+      tinted(b, WiiUIcons::IconLock, r.right() - 14, r.y, rgb(0xFFFFFF));
+    }
+  }
+}
+
+const char* focusLabel() {
+  if (s.focus == Focus::Avatar) {
+    return s.me.name;
+  }
+  if (s.focus == Focus::Dock) {
+    return appletTitle(k_dock[s.dock]);
+  }
+  Slot slot = s.slots[s.selected];
+  return slot.isEmpty() || s.moving ? "" : slotLabel(slot);
+}
+
+constexpr Rect k_titleArea = {36, 0, k_screenWidth - 72, 30};
+
+// The name of the selection in a pill at the top, the page dots under it
+void drawTitle(Band& b) {
+  if (!k_titleArea.intersects(b.clip())) {
+    return;
+  }
+  const char* label = focusLabel();
+  if (label[0]) {
+    int w = textWidth(label) + 16;
+    w = w > k_titleArea.w ? k_titleArea.w : w;
+    Rect pill = {k_screenWidth / 2 - w / 2, 2, w, 17};
+    roundFill(b, pill.translated(0, 1), 8, rgb(0x000000), 30);
+    roundFill(b, pill, 8, s.background == 2 ? rgb(0x2A3038) : rgb(0xFFFFFF));
+    text(b, label, k_screenWidth / 2, pill.y + 1, ink(), Small, Align::Center,
+         w - 8);
+  }
+  int pages = numberOfPages();
+  int page = currentPage();
+  int total = pages * 10 - 4;
+  int x = k_screenWidth / 2 - total / 2;
+  for (int i = 0; i < pages; i++) {
+    roundFill(b, {x + i * 10, 23, 6, 5}, 2,
+              i == page ? accent()
+                        : (s.background == 2 ? rgb(0x5A606A) : rgb(0xC9CED3)));
+  }
+}
+
+void drawAvatar(Band& b) {
+  Rect r = k_avatarRect;
+  bool selected = s.focus == Focus::Avatar && s.screen == Screen::Menu;
+  if (selected) {
+    roundFill(b, r.inset(-3), 9,
+              KDColor::Blend(accentLight(), accent(),
+                             static_cast<uint8_t>(255 * pulse())));
+  }
+  shadow(b, r, 6, 50);
+  roundFill(b, r, 6, rgb(0xFFFFFF));
+  roundFrame(b, r, 6, rgb(0xD3D8DC));
+  if (b.setClip(r.inset(1))) {
+    drawMiiBust(b, s.me, r.x + r.w / 2, r.y + 13, 15);
+  }
+  b.resetClip();
+  if (s.notifications.unread > 0) {
+    roundFill(b, {r.right() - 6, r.y - 3, 12, 12}, 3, rgb(0xFF8A1F));
+    char n[4];
+    fmt(n, sizeof(n), "%d", s.notifications.unread > 9 ? 9 :
+                            s.notifications.unread);
+    text(b, n, r.right(), r.y - 4, rgb(0xFFFFFF), Small, Align::Center);
+  }
+}
+
+void drawArrow(Band& b, bool right) {
+  const WiiUIcons::Image& im = WiiUIcons::k_images[WiiUIcons::IconArrow];
+  int y = k_gridY + k_tileStepY + k_tileSize / 2 - im.height / 2;
+  int alpha = 230;
+  if (right) {
+    tinted(b, WiiUIcons::IconArrow, k_screenWidth - im.width - 1, y + 1,
+           rgb(0xA9B2B9), 200);
+    tinted(b, WiiUIcons::IconArrow, k_screenWidth - im.width - 2, y,
+           rgb(0xFFFFFF), alpha);
+  } else {
+    // Mirror image of the arrow
+    Rect z = Rect{2, y, im.width, im.height}.intersection(b.clip());
+    for (int yy = z.y; yy < z.bottom(); yy++) {
+      KDColor* row = b.row(yy);
+      const uint8_t* a = im.alphas + (yy - y) * im.width;
+      for (int xx = z.x; xx < z.right(); xx++) {
+        int v = a[im.width - 1 - (xx - 2)];
+        int shade = yy > y ? a[(im.width - 1 - (xx - 2)) - im.width] : 0;
+        if (shade && !v) {
+          row[xx] = KDColor::Blend(rgb(0xA9B2B9), row[xx],
+                                   static_cast<uint8_t>(shade * 200 >> 8));
+        }
+        if (v) {
+          row[xx] = KDColor::Blend(rgb(0xFFFFFF), row[xx],
+                                   static_cast<uint8_t>(v * alpha >> 8));
+        }
+      }
+    }
+  }
+}
+
+Rect selectionFrame(int index) { return tileRect(index).inset(-5); }
+
+KDColor glowColor() {
+  return KDColor::Blend(accentLight(), accent(),
+                        static_cast<uint8_t>(120 * pulse()));
+}
+
+void drawSelection(Band& b) {
+  if (s.focus != Focus::Grid || s.screen != Screen::Menu) {
+    return;
+  }
+  Slot slot = s.slots[s.selected];
+  Rect r = tileRect(s.selected);
+  if (s.moving) {
+    // The tile follows the cursor, lifted, wobbling a little
+    int wobble = static_cast<int>(2 * sinf(now() / 90.f));
+    Rect lifted = {r.x - 3, r.y - 5 + wobble, r.w + 6, r.h + 6};
+    roundFill(b, lifted.inset(-3), 11, accent());
+    drawTile(b, lifted, slot, 256, true);
+    return;
+  }
+  Rect f = selectionFrame(s.selected);
+  if (!f.inset(-2).intersects(b.clip())) {
+    return;
+  }
+  if (slot.isEmpty()) {
+    // An empty place: just the outline
+    roundFrame(b, f, 12, glowColor());
+    roundFrame(b, f.inset(1), 11, glowColor());
+    roundFrame(b, f.inset(2), 10, glowColor(), 140);
+    return;
+  }
+  shadow(b, f, 12, 90);
+  roundFill(b, f, 12, glowColor());
+  roundFill(b, {f.x + 2, f.y + 2, f.w - 4, f.h / 2 - 2}, 10, rgb(0xFFFFFF),
+            60);
+  drawTile(b, r, slot, 256, false);
+}
+
+void drawDock(Band& b) {
+  if (!Rect{0, k_dockY - 4, k_screenWidth, k_screenHeight}.intersects(
+          b.clip())) {
+    return;
+  }
+  // A soft white shelf under the icons
+  for (int i = 0; i < 6; i++) {
+    fill(b, {0, k_dockY - 4 + i, k_screenWidth, 1}, rgb(0xFFFFFF),
+         s.background == 2 ? 10 + i * 3 : 40 + i * 12);
+  }
+  fill(b, {0, k_dockY + 2, k_screenWidth, k_screenHeight - k_dockY - 2},
+       rgb(0xFFFFFF), s.background == 2 ? 25 : 110);
+  for (int i = 0; i < k_dockItems; i++) {
+    int x = dockX(i);
+    int y = k_dockY + 6;
+    bool selected = s.focus == Focus::Dock && s.dock == i &&
+                    s.screen == Screen::Menu;
+    if (selected) {
+      Rect f = {x - 5, y - 5, k_dockIcon + 10, k_dockIcon + 10};
+      roundFill(b, f, 8, glowColor());
+      roundFill(b, f.inset(3), 6, rgb(0xFFFFFF));
+    }
+    image(b, k_dockIcons[i], x, y);
+    if (k_dock[i] == Applet::Notifications && s.notifications.unread > 0) {
+      disc(b, x + k_dockIcon - 1, y + 1, 5, rgb(0xFF8A1F));
+    }
+  }
+}
+
+void drawMenu(Band& b) {
+  background(b);
+  drawTitle(b);
+  drawAvatar(b);
+  int first = static_cast<int>(floorf(s.scroll));
+  for (int page = first; page <= first + 1 && page < k_maxPages; page++) {
+    if (page < 0) {
+      continue;
+    }
+    for (int k = 0; k < k_slotsPerPage; k++) {
+      int i = page * k_slotsPerPage + k;
+      if (s.slots[i].isEmpty() ||
+          (i == s.selected && s.focus == Focus::Grid)) {
+        continue;
+      }
+      Rect r = tileRect(i);
+      if (r.x > k_screenWidth || r.right() < 0) {
+        continue;
+      }
+      int alpha = 256;
+      if (introRunning()) {
+        int delay = (columnOf(i) + rowOf(i)) * 50;
+        int t = static_cast<int>(now() - s.introStart) - delay;
+        alpha = t <= 0 ? 0 : (t >= 250 ? 256 : t * 256 / 250);
+        r.y += (256 - alpha) * 12 / 256;
+      }
+      if (alpha > 0) {
+        drawTile(b, r, s.slots[i], alpha, false);
+      }
+    }
+  }
+  int page = currentPage();
+  if (page + 1 < numberOfPages()) {
+    drawArrow(b, true);
+  }
+  if (page > 0) {
+    drawArrow(b, false);
+  }
+  drawDock(b);
+  drawSelection(b);
+}
+
+/* ------------------------------------------------------- boot screens */
+
+void drawBoot(Band& b) {
+  uint32_t t = now() - s.screenStart;
+  fill(b, k_screen, rgb(0xFFFFFF));
+  int alpha = t < 500 ? static_cast<int>(t * 256 / 500)
+                      : (t > 1700 ? 256 - static_cast<int>((t - 1700) * 256 / 500)
+                                  : 256);
+  alpha = alpha < 0 ? 0 : (alpha > 256 ? 256 : alpha);
+  KDColor gray = KDColor::Blend(rgb(0x8A8F94), rgb(0xFFFFFF),
+                                static_cast<uint8_t>(alpha > 255 ? 255 : alpha));
+  KDColor blue = KDColor::Blend(rgb(0x00A7E1), rgb(0xFFFFFF),
+                                static_cast<uint8_t>(alpha > 255 ? 255 : alpha));
+  bigText(b, "Wii", 112, 84, gray, 4);
+  bigText(b, "U", 236, 84, blue, 4);
+  text(b, "Wii U-OS pour NumWorks", 160, 172, gray, Small, Align::Center);
+}
+
+void drawHealth(Band& b) {
+  fill(b, k_screen, rgb(0xFFFFFF));
+  vgradient(b, {0, 0, k_screenWidth, 60}, rgb(0xE9EEF2), rgb(0xFFFFFF));
