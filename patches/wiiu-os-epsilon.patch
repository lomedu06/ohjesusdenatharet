+#pragma once
+
+/* Internal state of the Wii U-OS menu, shared by the menu (shell.cpp), the
+ * Wii U apps (apps.cpp) and the Miis (mii.cpp). All of it is static: it
+ * survives leaving the home app to run a calculator app or a game. */
+
+#include <ion/events.h>
+#include <stdint.h>
+
+#include "gfx.h"
+#include "mii.h"
+#include "shell.h"
+
+namespace Home {
+namespace WiiU {
+
+/* Wii U-OS apps, which run inside the home app */
+enum class Applet : uint8_t {
+  MiiMaker = 0,
+  Settings,
+  Activity,
+  Parental,
+  Health,
+  WiiMode,
+  Plaza,
+  Miiverse,
+  Friends,
+  Shop,
+  Browser,
+  Notifications,
+  Downloads,
+  Drawing,  // Miiverse post editor
+  NumberOfApplets
+};
+constexpr int k_numberOfApplets = static_cast<int>(Applet::NumberOfApplets);
+
+/* One place of the menu grid */
+struct Slot {
+  enum class Kind : uint8_t { Empty = 0, Builtin, External, Applet };
+  Kind kind;
+  int8_t index;  // AppsContainer index, external app index, Applet
+  bool operator==(const Slot& o) const {
+    return kind == o.kind && index == o.index;
+  }
+  bool isEmpty() const { return kind == Kind::Empty; }
+};
+
+constexpr int k_columns = 5;
+constexpr int k_rows = 3;
+constexpr int k_slotsPerPage = k_columns * k_rows;
+constexpr int k_maxPages = 5;
+constexpr int k_maxSlots = k_slotsPerPage * k_maxPages;
+constexpr int k_dockItems = 7;
+
+enum class Screen : uint8_t { Boot, Health, Menu, App };
+enum class Focus : uint8_t { Grid, Avatar, Dock };
+
+/* ----------------------------------------------------------- Wii U apps */
+
+struct MiiMakerState {
+  uint8_t row;
+  bool editing;  // typing the name
+};
+
+struct SettingsState {
+  uint8_t row;
+  bool open;  // inside the panel of the row
+  uint8_t sub;
+  bool formatAsked;
+  uint8_t formatAnswer;  // 0 none, 1 "nice try"
+};
+
+struct ActivityEntry {
+  Slot slot;
+  uint16_t launches;
+  uint32_t seconds;
+};
+
+struct ActivityState {
+  constexpr static int k_entries = 24;
+  ActivityEntry entries[k_entries];
+  uint8_t count;
+  uint8_t scroll;
+  uint32_t totalSeconds;  // time in the apps
+  uint32_t menuSeconds;   // time in the Wii U menu
+  // The app that was launched and when (0: none)
+  Slot running;
+  uint32_t runningSince;
+};
+
+struct ParentalState {
+  char pin[5];       // empty: no restrictions
+  bool lockGames;    // .nwa games
+  bool lockPython;   // Python app
+  bool lockBrowser;  // Wii U-OS browser
+  bool lockMiiverse;
+  uint8_t row;
+  // PIN pad (asked before opening something locked or these settings)
+  bool asking;
+  char typed[5];
+  uint8_t typedLength;
+  bool wrong;
+  bool newPin;      // typing a new PIN
+  Slot pending;     // what to open once the PIN is right
+  bool pendingApplet;
+  uint8_t pendingAppletIndex;
+  bool unlocked;    // the settings were opened with the PIN
+};
+
+struct Post {
+  uint8_t author;      // friend index, 0xFF: you
+  uint8_t community;   // index in the community names
+  uint8_t text;        // index in the post texts (or calculation)
+  uint8_t kind;        // 0 text, 1 calculation, 2 drawing
+  uint16_t yeahs;
+  bool yeahed;
+  uint16_t minutesAgo;
+};
+
+struct MiiverseState {
+  constexpr static int k_posts = 12;
+  Post posts[k_posts];
+  uint8_t count;
+  uint8_t selected;
+  uint8_t calcSeen;  // Calc::count() already turned into posts
+};
+
+struct DrawingState {
+  constexpr static int k_width = 120;
+  constexpr static int k_height = 64;
+  uint8_t pixels[k_width * k_height / 8];
+  uint8_t x, y;
+  bool pen;     // drawing while moving
+  bool eraser;
+  bool hasPost;  // the drawing was posted on Miiverse
+};
+
+struct WiiModeState {
+  uint8_t phase;  // 0 loading, 1 Wii menu, 2 channel preview
+  uint8_t channel;
+  uint32_t start;
+  uint8_t message;  // channel preview: 0 none, 1 started
+};
+
+struct PlazaMii {
+  int16_t x, y;    // 1/16 pixel
+  int16_t tx, ty;  // target
+  uint8_t who;     // friend index (0xFF: you)
+  uint8_t bubbleText;
+  uint16_t bubbleUntil;  // in frames
+  uint8_t step;
+};
+
+struct PlazaState {
+  constexpr static int k_miis = 9;
+  PlazaMii miis[k_miis];
+  uint16_t frame;
+  uint8_t selected;
+  bool zoom;
+  bool ready;
+};
+
+struct ShopState {
+  uint8_t selected;
+  uint8_t message;  // 0 none, 1 not enough money, 2 installed
+};
+
+struct BrowserState {
+  uint8_t selected;
+  uint8_t page;  // 0 bookmarks, 1 loading, 2 error, 3 help
+  uint32_t loadStart;
+  uint8_t scroll;
+};
+
+struct Notification {
+  uint8_t kind;
+  uint8_t arg;
+  uint16_t minute;  // clock minute when it arrived
+};
+
+struct NotificationsState {
+  constexpr static int k_count = 8;
+  Notification items[k_count];
+  uint8_t count;
+  uint8_t unread;
+  uint8_t selected;
+  uint32_t ledUntil;
+};
+
+struct DownloadsState {
+  uint16_t progress;  // system update, 0..1000
+  bool started;
+  bool done;
+  uint8_t selected;
+};
+
+struct FriendsState {
+  uint8_t selected;
+  bool profile;
+};
+
+/* --------------------------------------------------------------- state */
+
+struct State {
+  bool initialized;
+  Screen screen;
