+
+constexpr int k_textSize = 32;
+constexpr int k_capacity = 8;
+
+void push(const char* input, const char* output);
+// Number of results pushed since the calculator started (wraps at 256)
+uint8_t count();
+// i = 0 is the most recent; false if there is no such result
+bool at(int i, const char** input, const char** output);
+
