+bool isDigit(Event e, int* digit) {
+  const char* t = e.text();
+  if (t && t[0] >= '0' && t[0] <= '9' && t[1] == 0) {
+    *digit = t[0] - '0';
+    return true;
+  }
+  return false;
+}
