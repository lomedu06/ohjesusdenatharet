+#!/usr/bin/env python3
+"""Generate the Wii U-OS pictures for the NumWorks home screen.
+
+Everything is drawn as vector shapes in a 100x100 design space and rendered
+with 8x supersampling. These are original drawings in the spirit of the
+Wii U menu (glossy white tiles, flat colourful art), nothing is copied.
+
+  - tile art (36 px): what is shown inside the white glass tiles of the
+    menu grid, one per calculator app and per Wii U-OS app;
+  - dock icons (24 px): Miiverse, friends, shop, browser, notifications,
+    downloads and the TV / GamePad button of the bottom bar;
+  - a few glyphs (the A button, the page arrow, a padlock, a heart).
+
+All pictures are exported as RGB565 + 8-bit alpha.
+
+Usage: gen_icons.py <output_header.h> [--preview preview.png]
+"""
+
+import math
+import sys
+
+from PIL import Image, ImageDraw, ImageFont
+
+SS = 8
+D = 100
+
+FONT_PATHS = [
+    ("/System/Library/Fonts/Helvetica.ttc", 1),
+    ("/System/Library/Fonts/Supplemental/Arial Bold.ttf", 0),
+    ("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 0),
+]
+
+
+def font(size):
+    for path, index in FONT_PATHS:
+        try:
+            return ImageFont.truetype(path, size, index=index)
+        except Exception:
+            continue
+    return ImageFont.load_default()
+
+
+def hexc(v, a=255):
+    return ((v >> 16) & 255, (v >> 8) & 255, v & 255, a)
+
+
+WHITE = hexc(0xFFFFFF)
+CLEAR = (0, 0, 0, 0)
+
+
+class Painter:
+    """ImageDraw replaces pixels: shapes drawn with a translucent colour are
+    drawn on a layer and composited over the picture instead."""
+
+    def __init__(self, img):
+        self.img = img
+        self.base = ImageDraw.Draw(img)
+
+    def __getattr__(self, method):
+        def paint(*args, **kwargs):
+            colours = [kwargs.get("fill"), kwargs.get("outline")]
+            translucent = any(isinstance(c, tuple) and len(c) == 4 and 0 < c[3] < 255
+                              for c in colours)
+            if not translucent:
+                return getattr(self.base, method)(*args, **kwargs)
+            layer = Image.new("RGBA", self.img.size, CLEAR)
+            getattr(ImageDraw.Draw(layer), method)(*args, **kwargs)
+            self.img.alpha_composite(layer)
+        return paint
+
+
+class Canvas:
+    """Drawing in 100x100 design units, supersampled."""
+
+    def __init__(self):
+        self.n = D * SS
+        self.img = Image.new("RGBA", (self.n, self.n), CLEAR)
+        self.d = Painter(self.img)
+
+    def s(self, v):
+        return v * SS
+
+    def box(self, x0, y0, x1, y1):
+        return [self.s(x0), self.s(y0), self.s(x1), self.s(y1)]
+
+    def rrect(self, x0, y0, x1, y1, r, fill=WHITE, outline=None, width=0):
+        self.d.rounded_rectangle(self.box(x0, y0, x1, y1), radius=self.s(r),
+                                 fill=fill, outline=outline,
+                                 width=int(round(self.s(width))) if width else 0)
+
+    def rect(self, x0, y0, x1, y1, fill=WHITE):
+        self.d.rectangle(self.box(x0, y0, x1, y1), fill=fill)
+
+    def circle(self, cx, cy, r, fill=WHITE, outline=None, width=0):
+        self.d.ellipse(self.box(cx - r, cy - r, cx + r, cy + r), fill=fill,
+                       outline=outline,
+                       width=int(round(self.s(width))) if width else 0)
+
+    def ellipse(self, x0, y0, x1, y1, fill=WHITE):
+        self.d.ellipse(self.box(x0, y0, x1, y1), fill=fill)
+
+    def poly(self, pts, fill=WHITE):
+        self.d.polygon([(self.s(x), self.s(y)) for x, y in pts], fill=fill)
+
+    def line(self, pts, width, fill=WHITE, round_caps=True):
+        p = [(self.s(x), self.s(y)) for x, y in pts]
+        w = int(round(self.s(width)))
+        self.d.line(p, fill=fill, width=w, joint="curve")
+        if round_caps:
+            for x, y in (p[0], p[-1]):
+                self.d.ellipse([x - w / 2, y - w / 2, x + w / 2, y + w / 2], fill=fill)
+
+    def arc(self, cx, cy, r, a0, a1, width, fill=WHITE):
+        self.d.arc(self.box(cx - r, cy - r, cx + r, cy + r), a0, a1, fill=fill,
+                   width=int(round(self.s(width))))
+
+    def pie(self, cx, cy, r, a0, a1, fill=WHITE):
+        self.d.pieslice(self.box(cx - r, cy - r, cx + r, cy + r), a0, a1, fill=fill)
+
+    def text(self, cx, cy, t, size, fill=WHITE):
+        f = font(int(self.s(size)))
+        self.d.text((self.s(cx), self.s(cy)), t, font=f, fill=fill, anchor="mm")
+
+    def render(self, size):
+        return self.img.resize((size, size), Image.LANCZOS)
+
+
+def gradient_bg(c, top, bottom, r=16):
+    """Rounded square art background with a vertical gradient."""
+    grad = Image.new("RGBA", (c.n, c.n))
+    t = hexc(top)
+    b = hexc(bottom)
+    for y in range(c.n):
+        k = y / (c.n - 1)
+        col = tuple(int(t[i] + (b[i] - t[i]) * k) for i in range(4))
+        grad.paste(col, (0, y, c.n, y + 1))
+    mask = Image.new("L", (c.n, c.n), 0)
+    ImageDraw.Draw(mask).rounded_rectangle([0, 0, c.n - 1, c.n - 1], radius=c.s(r), fill=255)
+    c.img.paste(grad, (0, 0), mask)
+    # Glossy highlight on the top half
+    gloss = Image.new("RGBA", (c.n, c.n), CLEAR)
+    gd = ImageDraw.Draw(gloss)
+    gd.rounded_rectangle([c.s(4), c.s(3), c.n - c.s(4), c.s(44)], radius=c.s(14),
+                         fill=(255, 255, 255, 46))
+    c.img.alpha_composite(gloss)
+
+
+def white_bg(c):
+    gradient_bg(c, 0xFFFFFF, 0xE9EDF0)
+
+
+# ------------------------------------------------------------- tile art
+
+def art_calculation(c):
+    gradient_bg(c, 0xF0393F, 0xC0141B)
+    c.rrect(16, 16, 84, 84, 10, fill=hexc(0xFFFFFF, 60))
+    c.rect(28, 36, 46, 41)
+    c.rect(34.5, 29.5, 39.5, 47.5)
+    c.rect(56, 36, 74, 41)
+    c.line([(29, 60), (45, 76)], 5)
+    c.line([(45, 60), (29, 76)], 5)
+    c.rect(56, 61, 74, 65)
+    c.rect(56, 70, 74, 74)
+
+
+def art_graph(c):
+    gradient_bg(c, 0x33C6F2, 0x0A8FC8)
+    c.line([(20, 82), (20, 18)], 4, fill=hexc(0xFFFFFF, 150))
+    c.line([(14, 70), (86, 70)], 4, fill=hexc(0xFFFFFF, 150))
+    pts = [(14 + i * 1.5, 70 - 42 * math.sin((i * 1.5) / 72 * math.pi * 1.6) * (0.4 + i / 70))
+           for i in range(48)]
+    c.line(pts, 7)
+
+
+def art_solver(c):
+    gradient_bg(c, 0xFFA640, 0xF07800)
+    c.text(50, 50, "x=?", 40)
+
+
+def art_statistics(c):
+    gradient_bg(c, 0xFFD21F, 0xF0A800)
+    for i, h in enumerate((30, 52, 40, 64)):
+        x = 18 + i * 17
+        c.rrect(x, 80 - h, x + 12, 80, 2)
+    c.rect(14, 80, 86, 84)
+
+
+def art_distributions(c):
+    gradient_bg(c, 0x2ED1B0, 0x00957A)
+    pts = [(12 + i * 2, 80 - 56 * math.exp(-(((12 + i * 2) - 50) / 15) ** 2)) for i in range(39)]
+    c.poly(pts + [(88, 80), (12, 80)], fill=hexc(0xFFFFFF, 110))
+    c.line(pts, 5)
+
