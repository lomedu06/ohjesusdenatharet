+/* The calculator's libc has no vsnprintf: a small printf (from Mint-OS) */
+void fmt(char* out, int size, const char* f, ...) {
+  va_list args;
+  va_start(args, f);
+  int n = 0;
+  auto put = [&](char c) {
+    if (n < size - 1) {
+      out[n] = c;
+    }
+    n++;
+  };
+  for (; *f; f++) {
+    if (*f != '%') {
+      put(*f);
+      continue;
+    }
+    f++;
+    bool left = false, zero = false;
+    while (*f == '-' || *f == '0') {
+      left = left || *f == '-';
+      zero = zero || *f == '0';
+      f++;
+    }
+    int width = 0;
+    while (*f >= '0' && *f <= '9') {
+      width = width * 10 + (*f++ - '0');
+    }
+    int precision = -1;
+    if (*f == '.') {
+      f++;
+      precision = 0;
+      while (*f >= '0' && *f <= '9') {
+        precision = precision * 10 + (*f++ - '0');
+      }
+    }
+    bool isLong = false;
+    while (*f == 'l') {
+      isLong = true;
+      f++;
+    }
+    char digits[24];
+    const char* str = digits;
+    int len = 0;
+    if (*f == 'd' || *f == 'u') {
+      unsigned long v;
+      bool negative = false;
+      if (*f == 'd') {
+        long sv = isLong ? va_arg(args, long) : va_arg(args, int);
+        negative = sv < 0;
+        v = negative ? static_cast<unsigned long>(-sv)
+                     : static_cast<unsigned long>(sv);
+      } else {
+        v = isLong ? va_arg(args, unsigned long) : va_arg(args, unsigned);
+      }
+      char tmp[24];
+      int k = 0;
+      do {
+        tmp[k++] = '0' + v % 10;
+        v /= 10;
+      } while (v > 0);
+      if (negative) {
+        digits[len++] = '-';
+      }
+      while (k > 0) {
+        digits[len++] = tmp[--k];
+      }
+    } else if (*f == 's') {
+      str = va_arg(args, const char*);
+      if (str == nullptr) {
+        str = "";
+      }
+      len = strlen(str);
+      if (precision >= 0 && len > precision) {
+        len = precision;
+      }
+    } else if (*f == 'c') {
+      digits[0] = static_cast<char>(va_arg(args, int));
+      len = 1;
+    } else if (*f == '%') {
+      digits[0] = '%';
+      len = 1;
+    } else {
+      break;
+    }
+    int pad = width > len ? width - len : 0;
+    if (!left) {
+      for (int i = 0; i < pad; i++) {
+        put(zero && *f != 's' ? '0' : ' ');
+      }
+    }
+    for (int i = 0; i < len; i++) {
+      put(str[i]);
+    }
+    if (left) {
+      for (int i = 0; i < pad; i++) {
+        put(' ');
+      }
+    }
+  }
+  va_end(args);
+  if (size > 0) {
+    out[n < size ? n : size - 1] = 0;
+  }
+}
