+/* =================================================== Notifications */
+
+void notificationText(const Notification& n, char* buffer, int size) {
+  switch (n.kind) {
+    case 0:
+      fmt(buffer, size, "Bienvenue sur Wii U-OS ! Var : la Place Mii.");
+      break;
+    case 1:
+      fmt(buffer, size, "Ton calcul a été publié sur Miiverse.");
+      break;
+    case 2:
+      fmt(buffer, size, "Batterie faible. Branche la calculatrice.");
+      break;
+    case 3:
+      fmt(buffer, size, "Charge en cours.");
+      break;
+    case 4:
+      fmt(buffer, size, "%s est en ligne.", friendName(n.arg));
+      break;
+    case 5:
+      fmt(buffer, size, "%s a mis un Ouah ! sur ton message.",
+          friendName(n.arg));
+      break;
+    case 6:
+      fmt(buffer, size, "Mise à jour du système téléchargée.");
+      break;
+    case 7:
+      fmt(buffer, size, "Le contrôle parental est activé.");
+      break;
+    case 8:
+      fmt(buffer, size, "Ton dessin a été publié sur Miiverse.");
+      break;
+    default:
+      buffer[0] = 0;
+  }
+}
+
+int notificationIcon(int kind) {
+  constexpr uint8_t icons[] = {
+      WiiUIcons::IconWii,      WiiUIcons::IconMiiverse,
+      WiiUIcons::IconHealth,   WiiUIcons::IconSettings,
+      WiiUIcons::IconFriends,  WiiUIcons::IconMiiverse,
+      WiiUIcons::IconDownloads, WiiUIcons::IconParental,
+      WiiUIcons::IconNotes};
+  return icons[kind % 9];
+}
+
+bool notificationsEvent(Event e) {
+  NotificationsState& n = s.notifications;
+  if (e == Events::Up && n.selected > 0) {
+    n.selected--;
+  } else if (e == Events::Down && n.selected + 1 < n.count) {
+    n.selected++;
+  } else if (e == Events::Back || e == Events::OK) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
+
+void notificationsRender(Band& b) {
+  NotificationsState& n = s.notifications;
+  char buffer[64];
+  char time[8];
+  if (n.count == 0) {
+    text(b, "Aucune notification.", 160, 110, k_inkLight, Small,
+         Align::Center);
+  }
+  int first = n.selected > 4 ? n.selected - 4 : 0;
+  for (int k = 0; k < 5 && first + k < n.count; k++) {
+    int i = first + k;
+    const Notification& it = n.items[i];
+    Rect r = {6, k_top + 4 + k * 37, 308, 34};
+    if (i == n.selected) {
+      roundFill(b, r.inset(-2), 9, accent());
+    }
+    roundFill(b, r, 8, k_white);
+    roundFrame(b, r, 8, k_line);
+    image(b, notificationIcon(it.kind), r.x + 5, r.y + 5, 24);
+    notificationText(it, buffer, sizeof(buffer));
+    paragraph(b, buffer, r.x + 36, r.y + 3, 32, k_ink, 2, 14);
+    timeText(time, sizeof(time), it.minute);
+    text(b, time, r.right() - 6, r.y + 3, k_inkLight, Small, Align::Right);
+  }
+  hintBar(b, "Retour : menu");
+}
+
+/* ====================================================== Downloads */
+
+bool downloadsEvent(Event e) {
+  DownloadsState& d = s.downloads;
+  if ((e == Events::OK || e == Events::EXE) && !d.started) {
+    d.started = true;
+    d.progress = 0;
+  } else if (e == Events::Back) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
+
+bool downloadsFrame() {
+  DownloadsState& d = s.downloads;
+  if (!d.started || d.done) {
+    return false;
+  }
+  d.progress += 6 + randomInt(10);
+  if (d.progress >= 1000) {
+    d.progress = 1000;
+    d.done = true;
+    addNotification(6, 0);
+  }
+  invalidate({0, k_top, k_screenWidth, 90});
+  return true;
+}
+
+void downloadsRender(Band& b) {
+  DownloadsState& d = s.downloads;
+  char buffer[48];
+  Rect r = {6, k_top + 4, 308, 76};
+  panel(b, r);
+  image(b, WiiUIcons::IconDownloads, r.x + 8, r.y + 8, 30);
+  text(b, "Mise à jour du système 5.5.6", r.x + 46, r.y + 8, k_ink);
+  if (!d.started) {
+    text(b, "Disponible - 42 Mo", r.x + 46, r.y + 24, k_inkLight);
+    roundFill(b, {r.x + 46, r.y + 46, 120, 20}, 10, accent());
+    text(b, "Télécharger", r.x + 106, r.y + 48, k_white, Small,
+         Align::Center);
+  } else {
+    fmt(buffer, sizeof(buffer), d.done ? "Terminé - redémarrage inutile"
+                                       : "Téléchargement... %d %%",
+        d.progress / 10);
+    text(b, buffer, r.x + 46, r.y + 24, d.done ? rgb(0x2EB82E) : k_inkLight);
+    roundFill(b, {r.x + 46, r.y + 50, 246, 10}, 5, rgb(0xDDE2E6));
+    roundFill(b, {r.x + 46, r.y + 50, 246 * d.progress / 1000, 10}, 5,
+              d.done ? rgb(0x2EB82E) : accent());
+  }
+  text(b, "Logiciels installés", 10, k_top + 88, k_inkLight);
+  int n = numberOfGames();
+  if (n == 0) {
