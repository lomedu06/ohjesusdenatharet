+/* ---------------------------------------------------------- transitions */
+
+namespace {
+
+void paint(Rect r) {
+  r = r.intersection(k_screen);
+  if (s_painter && !r.isEmpty()) {
+    s_painter(r);
+  }
+}
+
+// The part of outer that is not in inner (inner is inside outer)
+void paintBetween(Rect inner, Rect outer) {
+  paint({outer.x, outer.y, outer.w, inner.y - outer.y});
+  paint({outer.x, inner.bottom(), outer.w, outer.bottom() - inner.bottom()});
+  paint({outer.x, inner.y, inner.x - outer.x, inner.h});
+  paint({inner.right(), inner.y, outer.right() - inner.right(), inner.h});
+}
+
+Rect lerpRect(Rect a, Rect b, int t) {
+  return {a.x + (b.x - a.x) * t / 256, a.y + (b.y - a.y) * t / 256,
+          a.w + (b.w - a.w) * t / 256, a.h + (b.h - a.h) * t / 256};
+}
+
+constexpr int k_transitionSteps = 8;
+constexpr int k_transitionStepMs = 26;
+
+int easeOut(int i) {
+  int u = 256 - i * 256 / k_transitionSteps;
+  return 256 - u * u / 256;
+}
+
+bool transitionsEnabled() { return s_painter != nullptr && !s_fakeClock; }
+
+void waitStep(uint32_t start, int i) {
+  uint32_t target = start + i * k_transitionStepMs;
+  while (static_cast<uint32_t>(Ion::Timing::millis()) < target) {
+    Ion::Timing::msleep(1);
+  }
+}
+
+/* The new screen grows out of from, like a window opening (only the new
+ * ring is drawn at each step) */
+void zoomOpen(Rect from) {
+  Rect prev = from.intersection(k_screen);
+  paint(prev);
+  uint32_t start = Ion::Timing::millis();
+  for (int i = 1; i <= k_transitionSteps; i++) {
+    Rect r = lerpRect(from, k_screen, easeOut(i)).intersection(k_screen);
+    paintBetween(prev, r);
+    prev = r;
+    waitStep(start, i);
+  }
+}
+
+// The old screen shrinks into to, the new one appears around it
+void zoomClose(Rect to) {
+  Rect prev = k_screen;
+  uint32_t start = Ion::Timing::millis();
+  for (int i = 1; i <= k_transitionSteps; i++) {
+    Rect r = lerpRect(k_screen, to, easeOut(i)).intersection(k_screen);
+    paintBetween(r, prev);
+    prev = r;
+    waitStep(start, i);
+  }
+  paint(prev);
+}
+
+// Where the selection is in the menu, for the transitions
+Rect focusRect() {
+  if (s.screen != Screen::Menu && s.screen != Screen::App) {
+    return {150, 110, 20, 20};
+  }
+  switch (s.focus) {
+    case Focus::Avatar:
+      return k_avatarRect;
+    case Focus::Dock:
+      return {dockX(s.dock), k_dockY + 6, k_dockIcon, k_dockIcon};
+    default: {
+      Rect r = tileRect(s.selected);
+      return r.x < 0 || r.right() > k_screenWidth ? Rect{150, 110, 20, 20} : r;
+    }
+  }
+}
+
+void drawLoading(Band& b) {
+  vgradient(b, k_screen, rgb(0xFFFFFF), rgb(0xE6EAED));
+  Rect tile = {160 - 40, 76, 80, 80};
+  shadow(b, tile, 14, 80);
+  roundFill(b, tile, 14, rgb(0xFFFFFF));
+  roundFrame(b, tile, 14, rgb(0xD3D8DC));
+  drawSlotArt(b, s_loadingSlot, tile.x + 8, tile.y + 8, 64);
+  text(b, slotLabel(s_loadingSlot), 160, 170, rgb(0x4A4F55), Large,
+       Align::Center);
+  for (int i = 0; i < 3; i++) {
+    disc(b, 148 + i * 12, 202, 3, accent(), 120 + i * 60);
+  }
+}
+
+}  // namespace
+
+void openApplet(Applet a) {
+  if (Apps::appletLocked(a) && !Apps::consumeUnlock()) {
+    Apps::askPin({Slot::Kind::Applet, static_cast<int8_t>(a)}, true,
+                 static_cast<uint8_t>(a));
+    invalidateAll();
+    return;
+  }
+  if (a != Applet::Activity) {
+    activityStart(appletSlot(a));
+  }
+  Rect from = focusRect();
+  if (s.screen == Screen::App || s.parental.asking) {
+    from = {150, 110, 20, 20};
+  }
+  s.applet = a;
+  s.appletStart = now();
+  s.screen = Screen::App;
+  s.screenStart = now();
+  s.parental.asking = false;
+  Apps::enter(a);
+  if (transitionsEnabled()) {
+    zoomOpen(from);
+  } else {
+    invalidateAll();
+  }
+}
+
+void closeApplet() {
+  setAlphaLock(false);
+  activityStop();
+  s.screen = Screen::Menu;
+  s.screenStart = now();
+  if (transitionsEnabled()) {
+    zoomClose(focusRect());
+  } else {
+    invalidateAll();
+  }
+}
+
+void launchSlot(Slot slot) {
+  if (slot.kind == Slot::Kind::Applet) {
+    openApplet(static_cast<Applet>(slot.index));
+    return;
+  }
+  if (Apps::slotLocked(slot) && !Apps::consumeUnlock()) {
+    Apps::askPin(slot, false, 0);
+    invalidateAll();
+    return;
+  }
+  activityStart(slot);
+  // The tile grows into the loading screen, then the app opens
+  if (transitionsEnabled()) {
+    Rect from = s.screen == Screen::Menu ? focusRect() : Rect{150, 110, 20, 20};
+    s.parental.asking = false;
+    s_loading = true;
+    s_loadingSlot = slot;
+    zoomOpen(from);
+  }
+  s_launch = {slot.kind == Slot::Kind::Builtin ? Item::Kind::Builtin
+                                               : Item::Kind::External,
+              slot.index};
+}
+
+/* ============================================================== Shell */
+
+namespace Shell {
+
+void setInvalidator(void (*f)(Rect)) { s_invalidator = f; }
+
+void setPainter(void (*f)(Rect)) { s_painter = f; }
+
+void launchFailed() {
+  s_loading = false;
+  activityStop();
+  invalidateAll();
+}
+
+void enter() {
+  s_loading = false;
+  listApps();
+  if (!s.initialized) {
+    firstStart();
+  } else {
+    reconcileLayout();
+  }
+  /* Back from an app or a game: count its time. Coming back here while a
+   * Wii U-OS app was open means the Home key was pressed (the kernel jumps to
+   * the home app): like the HOME button, it goes back to the menu. */
+  activityStop();
+  if (s.screen == Screen::App) {
+    s.screen = Screen::Menu;
+    s.screenStart = now();
+  }
+  if (s.selected < 0 || s.selected >= k_maxSlots) {
+    s.selected = 0;
+  }
+  s.moving = false;
+  s.parental.asking = false;
+  s.scroll = static_cast<float>(currentPage());
+  s_lastTick = now();
+  Apps::updateMiiverse();
+  // Now and then, a friend comes online
+  s_enterCount++;
+  if (s.screen == Screen::Menu && s_enterCount % 3 == 0) {
+    addNotification(4, static_cast<uint8_t>(s_enterCount / 3 %
+                                            k_numberOfFriends));
+  }
+  if (s.screen == Screen::Menu) {
+    s.introStart = now();
+  }
+  s_launch = k_noItem;
+  invalidateAll();
+#if !PLATFORM_DEVICE
+  if (getenv("WIIU_SHOTS") && !s_fakeClock) {
+    photoSession();
+  }
+#endif
+}
+
+void leave() { setAlphaLock(false); }
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+bool handleEvent(Event e) {
+  if (s.parental.asking) {
+    return Apps::pinPadHandle(e);
+  }
+  switch (s.screen) {
+    case Screen::Boot:
+      if (e.isKeyboardEvent() && e != Events::OnOff) {
+        setScreen(Screen::Health);
+        return true;
+      }
+      return false;
+    case Screen::Health:
+      if (e == Events::OK || e == Events::EXE) {
+        openMenu();
+        return true;
+      }
+      return e.isKeyboardEvent() && e != Events::OnOff;
+    case Screen::Menu:
+      return handleMenuEvent(e);
+    case Screen::App:
+      if (e == Events::Home) {
+        closeApplet();
+        return true;
+      }
+      return Apps::handleEvent(s.applet, e);
+  }
+  return false;
+}
+
+bool tick() {
+  uint32_t t = now();
+  if (s.screen == Screen::Menu) {
+    s.activity.menuSeconds += (t - s_lastTick + 500) / 1000;
+  }
+  s_lastTick = t;
+  if (s.notifications.ledUntil != 0 && t > s.notifications.ledUntil) {
+    s.notifications.ledUntil = 0;
+    if (!s_fakeClock) {
+      Ion::LED::updateColorWithPlugAndCharge();
+    }
+  }
+  if (!s_fakeClock) {
+    checkBattery();
+  }
+  return false;
+}
+
+static bool menuAnimating() {
+  float d = s.scroll - currentPage();
+  return d > 0.002f || d < -0.002f || introRunning() || s.moving;
+}
+
+int framePeriod() {
+  switch (s.screen) {
+    case Screen::Boot:
+      return 40;
+    case Screen::Health:
+      return 60;
+    case Screen::Menu:
+      return menuAnimating() ? 40 : 80;
+    case Screen::App:
+      return Apps::animated(s.applet) ? 40 : 0;
+  }
+  return 0;
+}
+
+static bool approach(float* value, float target) {
+  float d = target - *value;
+  if (d > 0.002f || d < -0.002f) {
+    *value += d * 0.38f;
+    return true;
+  }
+  *value = target;
+  return false;
+}
+
+bool frame() {
+  switch (s.screen) {
+    case Screen::Boot:
+      if (now() - s.screenStart > 2300) {
+        setScreen(Screen::Health);
+      } else {
+        invalidateAll();
+      }
+      return true;
+    case Screen::Health:
+      invalidate({0, 200, k_screenWidth, 24});
+      return true;
+    case Screen::Menu: {
+      bool moving = approach(&s.scroll, static_cast<float>(currentPage()));
+      if (moving || introRunning() || s.moving) {
+        invalidateAll();
+        return true;
+      }
+      // Glow of the selection only
+      if (s.focus == Focus::Grid) {
+        invalidate(selectionFrame(s.selected).inset(-2));
+      } else if (s.focus == Focus::Dock) {
+        invalidate({dockX(s.dock) - 6, k_dockY, k_dockIcon + 12, 36});
+      } else {
+        invalidate(k_avatarRect.inset(-4));
+      }
+      return true;
+    }
+    case Screen::App:
+      return Apps::frame(s.applet);
+  }
+  return false;
+}
+
+void render(Band& b) {
+  if (s_loading) {
+    drawLoading(b);
+    return;
+  }
+  switch (s.screen) {
+    case Screen::Boot:
+      drawBoot(b);
+      break;
+    case Screen::Health:
+      drawHealth(b);
+      break;
+    case Screen::Menu:
+      drawMenu(b);
+      break;
+    case Screen::App:
+      Apps::render(s.applet, b);
+      break;
+  }
+  if (s.parental.asking) {
+    Apps::pinPadRender(b);
+  }
+}
+
+}  // namespace Shell
+
+/* ======================================================== photo session */
+
+#if !PLATFORM_DEVICE
+namespace {
+
+KDColor s_shot[k_screenWidth * k_screenHeight];
+int s_gifFrame = 0;
+
+void shoot(const char* name) {
+  Band band;
+  for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+    Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+    band.begin(area);
+    Shell::render(band);
+    memcpy(s_shot + y * k_screenWidth, band.pixels(),
+           sizeof(KDColor) * k_screenWidth * Band::k_maxHeight);
+  }
+  char path[512];
+  snprintf(path, sizeof(path), "%s/%s.raw", getenv("WIIU_SHOTS"), name);
+  FILE* f = fopen(path, "wb");
+  if (f) {
+    fwrite(s_shot, 2, k_screenWidth * k_screenHeight, f);
+    fclose(f);
+  }
+}
+
+void wait(int ms, const char* gif = nullptr, int every = 2) {
+  int n = 0;
+  for (int t = 0; t < ms; t += 40) {
+    s_fakeNow += 40;
+    if ((s_fakeNow / 40) % 8 == 0) {
+      Shell::tick();
+    }
+    Shell::frame();
+    if (gif && (n++ % every) == 0) {
+      char name[64];
+      snprintf(name, sizeof(name), "%s_%04d", gif, s_gifFrame++);
+      shoot(name);
+    }
+  }
+}
+
+void key(Event e, int ms = 200, const char* gif = nullptr) {
+  Shell::handleEvent(e);
+  Shell::takeLaunch();
+  wait(ms, gif);
+}
+
+void type(const char* text) {
+  for (const char* p = text; *p; p++) {
+    for (int k = 0; k < Event::k_specialEventsOffset; k++) {
+      Event ev(k);
+      const char* t = ev.text();
+      if (t && t[0] == *p && t[1] == 0) {
+        key(ev, 40);
+        break;
+      }
+    }
+  }
+}
+
+void photoSession() {
+  s_fakeClock = true;
+  s_fakeNow = 1000;
+  s.screenStart = s_fakeNow;
+  s.clockOffsetMinutes = 14 * 60 + 30;
+  Calc::push("6\xC3\x97" "7", "42");
+  Calc::push("2^10", "1024");
+  Apps::updateMiiverse();
+  wait(900);
+  shoot("boot");
+  wait(1600);
+  shoot("sante");
+  key(Events::OK, 160, "gifmenu");
+  wait(700, "gifmenu");
+  shoot("menu");
+  key(Events::Right, 280, "gifmenu");
+  key(Events::Right, 280, "gifmenu");
+  key(Events::Down, 280, "gifmenu");
+  key(Events::Right, 280, "gifmenu");
+  shoot("menu_selection");
+  for (int i = 0; i < 3; i++) {
+    key(Events::Right, 200, "gifmenu");
+  }
+  wait(400, "gifmenu");
+  shoot("menu_page2");
+  key(Events::Home, 400, "gifmenu");
+  key(Events::Down, 200, "gifmenu");
+  key(Events::Down, 200, "gifmenu");
+  key(Events::Down, 200, "gifmenu");
+  key(Events::Right, 200, "gifmenu");
+  key(Events::Right, 300, "gifmenu");
+  shoot("dock");
+  // Moving a tile
+  key(Events::Up, 100);
+  key(Events::Toolbox, 200);
+  key(Events::Left, 200);
+  shoot("deplacer");
+  key(Events::OK, 100);
+  key(Events::Right, 100);
+  key(Events::Toolbox, 100);
+  key(Events::Right, 100);
+  key(Events::OK, 100);
+  // Mii Maker
+  openApplet(Applet::MiiMaker);
+  wait(200);
+  key(Events::Down, 60);
+  key(Events::Down, 60);
+  key(Events::Right, 60);
+  key(Events::Down, 60);
+  key(Events::Right, 60);
+  key(Events::Right, 60);
+  key(Events::Up, 60);
+  key(Events::Up, 60);
+  shoot("mii_maker");
+  closeApplet();
+  // The others
+  struct Shot {
+    Applet applet;
+    const char* name;
+    int ms;
+  };
+  const Shot shots[] = {
+      {Applet::Miiverse, "miiverse", 200},
+      {Applet::Friends, "amis", 200},
+      {Applet::Shop, "boutique", 200},
+      {Applet::Notifications, "notifications", 200},
+      {Applet::Settings, "parametres", 200},
+      {Applet::Parental, "parental", 200},
+  };
+  for (const Shot& shot : shots) {
+    openApplet(shot.applet);
+    wait(shot.ms);
+    shoot(shot.name);
+    closeApplet();
+  }
+  openApplet(Applet::Downloads);
+  key(Events::OK, 2400);
+  shoot("telechargements");
+  closeApplet();
+  openApplet(Applet::Browser);
+  key(Events::Down, 60);
+  key(Events::OK, 2200);
+  shoot("navigateur");
+  closeApplet();
+  // Activity log, with some time spent in the apps
+  s.activity.entries[0].seconds += 1260;
+  s.activity.totalSeconds += 1260;
+  s.activity.menuSeconds += 300;
+  openApplet(Applet::Activity);
+  wait(200);
+  shoot("journal");
+  closeApplet();
+  // Drawing
+  openApplet(Applet::Drawing);
+  // A house
+  auto repeat = [](Event e, int n) {
+    for (int i = 0; i < n; i++) {
+      key(e, 0);
+    }
+  };
+  repeat(Events::Left, 20);
+  repeat(Events::Down, 16);
+  key(Events::OK, 0);
+  repeat(Events::Up, 24);
+  repeat(Events::Right, 40);
+  repeat(Events::Down, 24);
+  repeat(Events::Left, 40);
+  repeat(Events::Up, 24);
+  for (int i = 0; i < 20; i++) {
+    key(Events::Right, 0);
+    key(Events::Up, 0);
+  }
+  for (int i = 0; i < 20; i++) {
+    key(Events::Right, 0);
+    key(Events::Down, 0);
+  }
+  key(Events::OK, 0);
+  repeat(Events::Left, 25);
+  repeat(Events::Down, 24);
+  key(Events::OK, 0);
+  repeat(Events::Up, 12);
+  repeat(Events::Right, 10);
+  repeat(Events::Down, 12);
+  key(Events::OK, 0);
+  wait(80);
+  shoot("dessin");
+  closeApplet();
+  // Wii mode
+  openApplet(Applet::WiiMode);
+  wait(2600);
+  shoot("mode_wii");
+  closeApplet();
+  // Plaza
+  openApplet(Applet::Plaza);
+  wait(3000, "gifplaza", 2);
+  shoot("place_mii");
+  closeApplet();
+  // PIN
+  s.parental.lockGames = true;
+  strlcpy(s.parental.pin, "1234", sizeof(s.parental.pin));
+  Apps::askPin({Slot::Kind::Builtin, 1}, false, 0);
+  type("12");
+  wait(100);
+  shoot("code_parental");
+  exit(0);
+}
+
+}  // namespace
+#endif
+
+}  // namespace WiiU
