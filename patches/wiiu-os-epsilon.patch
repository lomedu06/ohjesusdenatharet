+/* ---------------------------------------------------- parental lock */
+
+bool slotLocked(Slot slot) {
+  const ParentalState& p = s.parental;
+  if (p.pin[0] == 0) {
+    return false;
+  }
+  if (slot.kind == Slot::Kind::External) {
+    return p.lockGames;
+  }
+  if (slot.kind == Slot::Kind::Builtin) {
+    return p.lockPython &&
+           slot.index ==
+               builtinIndexOfName(static_cast<int>(I18n::Message::CodeApp));
+  }
+  if (slot.kind == Slot::Kind::Applet) {
+    return appletLocked(static_cast<Applet>(slot.index));
+  }
+  return false;
+}
+
+bool appletLocked(Applet a) {
+  const ParentalState& p = s.parental;
+  if (p.pin[0] == 0) {
+    return false;
+  }
+  return a == Applet::Parental || (a == Applet::Browser && p.lockBrowser) ||
+         ((a == Applet::Miiverse || a == Applet::Drawing) && p.lockMiiverse);
+}
+
+bool consumeUnlock() {
+  bool u = s.parental.unlocked;
+  s.parental.unlocked = false;
+  return u;
+}
+
+void askPin(Slot slot, bool applet, uint8_t appletIndex) {
+  ParentalState& p = s.parental;
+  p.asking = true;
+  p.typedLength = 0;
+  p.typed[0] = 0;
+  p.wrong = false;
+  p.newPin = false;
+  p.pending = slot;
+  p.pendingApplet = applet;
+  p.pendingAppletIndex = appletIndex;
+  invalidateAll();
+}
+
+bool pinPadHandle(Event e) {
+  ParentalState& p = s.parental;
+  int digit;
+  if (isDigit(e, &digit)) {
+    if (p.typedLength < 4) {
+      p.typed[p.typedLength++] = static_cast<char>('0' + digit);
+      p.typed[p.typedLength] = 0;
+      p.wrong = false;
+    }
+    if (p.typedLength == 4) {
+      if (p.newPin) {
+        strlcpy(p.pin, p.typed, sizeof(p.pin));
+        p.asking = false;
+        p.newPin = false;
+        p.row = 0;
+        addNotification(7, 0);
+      } else if (strcmp(p.typed, p.pin) == 0) {
+        p.asking = false;
+        p.unlocked = true;
+        if (p.pendingApplet) {
+          openApplet(static_cast<Applet>(p.pendingAppletIndex));
+        } else if (!p.pending.isEmpty()) {
+          launchSlot(p.pending);
+        }
+        // Not used: forget it so that nothing else opens without the PIN
+        p.unlocked = false;
+      } else {
+        p.wrong = true;
+        p.typedLength = 0;
+        p.typed[0] = 0;
+      }
+    }
+  } else if (e == Events::Backspace) {
+    if (p.typedLength > 0) {
+      p.typed[--p.typedLength] = 0;
+    }
+  } else if (e == Events::Back || e == Events::Home) {
+    p.asking = false;
+    p.newPin = false;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
+
+void pinPadRender(Band& b) {
+  ParentalState& p = s.parental;
+  fill(b, k_screen, rgb(0x000000), 120);
+  Rect d = {50, 50, 220, 130};
+  panel(b, d);
+  image(b, WiiUIcons::IconParental, d.x + 10, d.y + 8, 26);
+  text(b, p.newPin ? "Nouveau code" : "Contrôle parental", d.x + 42, d.y + 12,
+       k_ink);
+  text(b, p.newPin ? "Choisis 4 chiffres :" : "Entre le code (4 chiffres) :",
+       d.x + 110, d.y + 40, k_inkLight, Small, Align::Center);
+  for (int i = 0; i < 4; i++) {
+    Rect box = {d.x + 38 + i * 38, d.y + 60, 30, 34};
+    roundFill(b, box, 6, rgb(0xEEF2F5));
+    roundFrame(b, box, 6, i == p.typedLength ? accent() : k_line);
+    if (i < p.typedLength) {
+      disc(b, box.x + 15, box.y + 17, 5, k_ink);
+    }
+  }
+  if (p.wrong) {
+    text(b, "Code incorrect.", d.x + 110, d.y + 104, rgb(0xE60012), Small,
+         Align::Center);
+  } else {
+    text(b, "Retour : annuler", d.x + 110, d.y + 104, k_inkLight, Small,
+         Align::Center);
+  }
+}
