+bool drawingPixel(int x, int y) {
+  int i = y * DrawingState::k_width + x;
+  return s.drawing.pixels[i >> 3] & (1 << (i & 7));
+}
+
+void setDrawingPixel(int x, int y, bool on) {
+  if (x < 0 || y < 0 || x >= DrawingState::k_width ||
+      y >= DrawingState::k_height) {
+    return;
+  }
+  int i = y * DrawingState::k_width + x;
+  if (on) {
+    s.drawing.pixels[i >> 3] |= (1 << (i & 7));
+  } else {
+    s.drawing.pixels[i >> 3] &= ~(1 << (i & 7));
+  }
+}
+
+void drawDrawing(Band& b, int x0, int y0, int scale, KDColor paper,
+                 KDColor inkColor) {
+  Rect r = {x0, y0, DrawingState::k_width * scale,
+            DrawingState::k_height * scale};
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    int py = (y - y0) / scale;
+    for (int x = z.x; x < z.right(); x++) {
+      row[x] = drawingPixel((x - x0) / scale, py) ? inkColor : paper;
+    }
+  }
+}
