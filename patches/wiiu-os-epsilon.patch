+#pragma once
+
+#include <ion/events.h>
+
+#include "gfx.h"
+
+namespace Home {
+namespace WiiU {
+
+/* Something to start from the menu: a calculator app or an external app
+ * (.nwa game). The Wii U-OS apps (Mii Maker, Miiverse...) run inside the
+ * home app and never go through here. */
+struct Item {
+  enum class Kind : uint8_t { None, Builtin, External };
+  Kind kind;
+  int16_t index;  // app index in AppsContainer, or external app index
+  bool isNone() const { return kind == Kind::None; }
+};
+
+constexpr Item k_noItem = {Item::Kind::None, 0};
+
+/* The Wii U menu. All its state is static: it survives leaving the home app
+ * to run a calculator app or a game. */
+namespace Shell {
+
+// The home app became active: refresh the list of apps and games
+void enter();
+// The home app is going away
+void leave();
+// Returns true if the event was used
+bool handleEvent(Ion::Events::Event event);
+// Called every Escher tick (300 ms). Returns true to redraw.
+bool tick();
+// Animation period in ms (0: nothing is animated, wait for events)
+int framePeriod();
+// One animation step. Returns true to redraw.
+bool frame();
+// Draws everything that intersects the band
+void render(Band& band);
+// An app to open, set by handleEvent; the caller opens it right away
+Item takeLaunch();
+// Where invalidated rectangles go (the home view)
+void setInvalidator(void (*invalidate)(Rect));
+/* Draws a rectangle of the screen right away (transitions between screens,
+ * which run inside one event) */
+void setPainter(void (*paint)(Rect));
+// The app returned by takeLaunch could not be opened (exam mode...)
+void launchFailed();
+
+}  // namespace Shell
+
+}  // namespace WiiU
+}  // namespace Home
