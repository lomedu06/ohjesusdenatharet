+/* The NumWorks font has no accented letters: French text is written without
+ * accents (é -> e, « » -> "), the way it is typed on the calculator. */
+void plainText(const char* in, char* out, int size) {
+  int n = 0;
+  while (*in && n < size - 1) {
+    uint8_t c = static_cast<uint8_t>(*in);
+    if (c == 0xC3 && in[1]) {
+      uint8_t d = static_cast<uint8_t>(in[1]);
+      const char* map =
+          "AAAAAAACEEEEIIII"  // C3 80..8F
+          "DNOOOOO*OUUUUYTs"  // C3 90..9F
+          "aaaaaaaceeeeiiii"  // C3 A0..AF
+          "dnooooo/ouuuuyty";  // C3 B0..BF
+      if (d >= 0x80 && d <= 0xBF) {
+        char r = map[d - 0x80];
+        if (d == 0x97) {
+          // × exists in the font: keep it
+          if (n + 2 < size) {
+            out[n++] = *in;
+            out[n++] = in[1];
+          }
+        } else {
+          out[n++] = r;
+        }
+        in += 2;
+        continue;
+      }
+    }
+    if (c == 0xC2 && (static_cast<uint8_t>(in[1]) == 0xAB ||
+                      static_cast<uint8_t>(in[1]) == 0xBB)) {
+      out[n++] = '"';
+      in += 2;
+      continue;
+    }
+    if (c == 0xC2 && static_cast<uint8_t>(in[1]) == 0xA0) {
+      out[n++] = ' ';
+      in += 2;
+      continue;
+    }
+    if (c == 0xC5 && (static_cast<uint8_t>(in[1]) == 0x93 ||
+                      static_cast<uint8_t>(in[1]) == 0x92)) {
+      // œ
+      out[n++] = static_cast<uint8_t>(in[1]) == 0x93 ? 'o' : 'O';
+      if (n < size - 1) {
+        out[n++] = static_cast<uint8_t>(in[1]) == 0x93 ? 'e' : 'E';
+      }
+      in += 2;
+      continue;
+    }
+    if (c == 0xE2 && static_cast<uint8_t>(in[1]) == 0x80) {
+      uint8_t d = static_cast<uint8_t>(in[2]);
+      // ’ ‘ -> ', “ ” -> ", … -> ..., – — -> -
+      char r = (d == 0x98 || d == 0x99) ? '\''
+               : (d == 0x9C || d == 0x9D) ? '"'
+               : (d == 0x93 || d == 0x94) ? '-'
+                                          : 0;
+      if (d == 0xA6) {
+        for (int k = 0; k < 3 && n < size - 1; k++) {
+          out[n++] = '.';
+        }
+        in += 3;
+        continue;
+      }
+      if (r) {
+        out[n++] = r;
+        in += 3;
+        continue;
+      }
+    }
+    out[n++] = *in++;
+  }
+  out[n] = 0;
+}
+
+int glyphWidth(KDFont::Size font) { return KDFont::GlyphMaxWidth(font); }
+int glyphHeight(KDFont::Size font) { return KDFont::GlyphHeight(font); }
+
+int textWidth(const char* s, KDFont::Size font) {
+  char plain[128];
+  plainText(s, plain, sizeof(plain));
+  return KDFont::Font(font)->stringSize(plain).width();
+}
+
+void text(Band& b, const char* s, int x, int y, KDColor c, KDFont::Size font,
+          Align align, int maxWidth) {
+  if (s == nullptr || s[0] == 0) {
+    return;
+  }
+  char plain[128];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  int h = glyphHeight(font);
+  if (y >= b.clip().bottom() || y + h <= b.clip().y) {
+    return;
+  }
+  // Cut the text so that it fits in maxWidth (and in the buffer)
+  constexpr int k_maxChars = 48;
+  char buffer[k_maxChars + 4];
+  int gw = glyphWidth(font);
+  int limit = (maxWidth < k_textBufferWidth ? maxWidth : k_textBufferWidth) / gw;
+  int len = strlen(s);
+  if (limit <= 0) {
+    return;
+  }
+  if (len > limit || len > k_maxChars) {
+    int keep = (limit < k_maxChars ? limit : k_maxChars) - 1;
+    if (keep < 1) {
+      keep = 1;
+    }
+    // Do not cut a UTF-8 sequence in the middle
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    // Cut like the reference ("Calcul", "Equati"), with no ellipsis
+    keep++;
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    memcpy(buffer, s, keep);
+    buffer[keep] = 0;
+    s = buffer;
+  }
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  if (align == Align::Center) {
+    x -= w / 2;
+  } else if (align == Align::Right) {
+    x -= w;
+  }
+  Rect z = Rect{x, y, w, h}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite,
+                  .backgroundColor = KDBlack,
+                  .font = font});
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src = s_textBuffer + (yy - y) * k_textBufferWidth - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[xx].green();
+      if (a) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+
+void bigText(Band& b, const char* s, int x, int y, KDColor c, int scale,
+             Align align) {
+  KDFont::Size font = KDFont::Size::Large;
+  char plain[64];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  int h = size.height() < k_textBufferHeight ? size.height() : k_textBufferHeight;
+  if (align == Align::Center) {
+    x -= w * scale / 2;
+  } else if (align == Align::Right) {
+    x -= w * scale;
+  }
+  Rect z = Rect{x, y, w * scale, h * scale}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite, .backgroundColor = KDBlack, .font = font});
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    // Bilinear sampling of the coverage, for smooth big digits
+    int fy = ((yy - y) * 256 + 128) / scale - 128;
+    int y0 = fy >> 8, ty = fy & 255;
+    if (fy < 0) {
+      y0 = 0;
+      ty = 0;
+    }
+    int y1 = y0 + 1 < h ? y0 + 1 : y0;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int fx = ((xx - x) * 256 + 128) / scale - 128;
+      int x0 = fx >> 8, tx = fx & 255;
+      if (fx < 0) {
+        x0 = 0;
+        tx = 0;
+      }
+      int x1 = x0 + 1 < w ? x0 + 1 : x0;
+      int a00 = s_textBuffer[y0 * k_textBufferWidth + x0].green();
+      int a10 = s_textBuffer[y0 * k_textBufferWidth + x1].green();
+      int a01 = s_textBuffer[y1 * k_textBufferWidth + x0].green();
+      int a11 = s_textBuffer[y1 * k_textBufferWidth + x1].green();
+      int top = a00 + (a10 - a00) * tx / 256;
+      int bottom = a01 + (a11 - a01) * tx / 256;
+      int a = top + (bottom - top) * ty / 256;
+      // Sharpen the edges a little
+      a = (a - 64) * 2;
+      if (a > 0) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+
+}  // namespace WiiU
+}  // namespace Home
diff --git a/epsilon/apps/home/wiiu/gfx.h b/epsilon/apps/home/wiiu/gfx.h
new file mode 100644
index 0000000000..778dc0f24e
--- /dev/null
+++ b/epsilon/apps/home/wiiu/gfx.h
@@ -0,0 +1,93 @@
+#pragma once
+
+/* Wii U-OS drawing primitives (the band renderer of Mint-OS).
+ *
+ * The screen is composed in RAM one horizontal band at a time (background,
+ * tiles, text) and every finished band is pushed to the LCD in one go: no
+ * flicker, and redrawing a small dirty rectangle only costs that rectangle. */
+
+#include <ion/display.h>
+#include <ion/external_apps.h>
+#include <kandinsky/color.h>
+#include <kandinsky/font.h>
+#include <stdint.h>
+
+#include "wiiu_icons.h"
+
+namespace Home {
+namespace WiiU {
+
+constexpr int k_screenWidth = Ion::Display::Width;
+constexpr int k_screenHeight = Ion::Display::Height;
+
+struct Rect {
+  int x, y, w, h;
+  int right() const { return x + w; }
+  int bottom() const { return y + h; }
+  bool isEmpty() const { return w <= 0 || h <= 0; }
+  bool contains(int px, int py) const {
+    return px >= x && py >= y && px < x + w && py < y + h;
+  }
+  bool intersects(const Rect& o) const {
+    return x < o.right() && o.x < right() && y < o.bottom() && o.y < bottom();
+  }
+  Rect intersection(const Rect& o) const;
+  Rect inset(int d) const { return {x + d, y + d, w - 2 * d, h - 2 * d}; }
+  Rect translated(int dx, int dy) const { return {x + dx, y + dy, w, h}; }
+};
+
+constexpr Rect k_screen = {0, 0, k_screenWidth, k_screenHeight};
+
+// The band being composed, and the clipping rectangle inside it
+class Band {
+ public:
+  constexpr static int k_maxHeight = 12;
+  void begin(Rect area);
+  const Rect& area() const { return m_area; }
+  const Rect& clip() const { return m_clip; }
+  // Restricts drawing to r (intersected with the band). Returns false if empty.
+  bool setClip(Rect r);
+  void resetClip() { m_clip = m_area; }
+  // Pointer to pixel (0, y) of the band, valid for x in [area.x, area.right)
+  KDColor* row(int y) const;
+  const KDColor* pixels() const;
+
+ private:
+  Rect m_area;
+  Rect m_clip;
+};
+
+enum class Align : uint8_t { Left, Center, Right };
+
+KDColor mix(uint32_t a, uint32_t b, int t256);
+void fill(Band& b, Rect r, KDColor c, int alpha = 256);
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha = 256);
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha = 256);
+void frame(Band& b, Rect r, KDColor c, int alpha = 256);
+// Soft drop shadow around r
+void shadow(Band& b, Rect r, int radius, int strength);
+void disc(Band& b, int cx, int cy, int r, KDColor c, int alpha = 256);
+void ellipse(Band& b, Rect r, KDColor c, int alpha = 256);
+void vgradient(Band& b, Rect r, KDColor top, KDColor bottom);
+// Colour image from wiiu_icons.h, at its size or scaled to size pixels wide
+void image(Band& b, int icon, int x, int y, int size = 0, int alpha = 256);
+// The alpha of an image, painted in one colour
+void tinted(Band& b, int icon, int x, int y, KDColor c, int alpha = 256);
+// Icon of an external app (.nwa), scaled to size x size
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size);
+// Text whose top-left corner is (x, y), cut at maxWidth pixels
+void text(Band& b, const char* s, int x, int y, KDColor c,
+          KDFont::Size font = KDFont::Size::Small, Align align = Align::Left,
+          int maxWidth = k_screenWidth);
+// Large font magnified scale times (titles)
+void bigText(Band& b, const char* s, int x, int y, KDColor c, int scale,
+             Align align = Align::Left);
+int textWidth(const char* s, KDFont::Size font = KDFont::Size::Small);
+int glyphWidth(KDFont::Size font = KDFont::Size::Small);
+int glyphHeight(KDFont::Size font = KDFont::Size::Small);
+
+inline KDColor rgb(uint32_t c) { return KDColor::RGB24(c); }
+
+}  // namespace WiiU
+}  // namespace Home
diff --git a/epsilon/apps/home/wiiu/mii.cpp b/epsilon/apps/home/wiiu/mii.cpp
new file mode 100644
index 0000000000..2c1ac83eb8
--- /dev/null
+++ b/epsilon/apps/home/wiiu/mii.cpp
@@ -0,0 +1,247 @@
+#include "mii.h"
+
+#include <string.h>
+
+namespace Home {
+namespace WiiU {
+
+namespace {
+
+constexpr uint32_t k_skinColors[k_skins] = {0xFFE2C8, 0xF8D0AA, 0xE6B086,
+                                            0xC98E62, 0x8D5A3B, 0x5C3A24};
+constexpr uint32_t k_hairColorValues[k_hairColors] = {
+    0x1E1E1E, 0x4A2C17, 0x8A2A12, 0x7A4E2A,
+    0x8C8C8C, 0x5A3A1A, 0xD8B040, 0xEADCA6};
+constexpr uint32_t k_favorites[k_favoriteColors] = {
+    0xE60012, 0xFF8A1F, 0xFFD21F, 0x8CD21E, 0x16A34A, 0x1E5FE6,
+    0x2ABFE0, 0xFF6FAE, 0x8A3FD0, 0x7A4A22, 0xF2F2F2, 0x2A2A2A};
+constexpr const char* k_favoriteNames[k_favoriteColors] = {
+    "Rouge", "Orange", "Jaune",   "Vert clair", "Vert", "Bleu",
+    "Bleu ciel", "Rose", "Violet", "Marron", "Blanc", "Noir"};
+constexpr const char* k_hairNames[k_hairStyles] = {
+    "Court", "Long", "Frange", "Raie", "Afro", "Couettes", "Chauve"};
+
+constexpr const char* k_friendNames[k_numberOfFriends] = {
+    "Lucas", "Emma", "Hugo", "Chloe", "Nathan",
+    "Lea",   "Yanis", "Ines", "Mme Martin", "Prof. Pi"};
+
+Mii s_friends[k_numberOfFriends];
+bool s_friendsReady = false;
+
+// Sizes are given in 1/100 of the head width
+inline int u(int size, int hundredths) { return size * hundredths / 100; }
+
+KDColor darker(uint32_t c, int amount) {
+  int r = (c >> 16) & 255, g = (c >> 8) & 255, b = c & 255;
+  r = r * (256 - amount) >> 8;
+  g = g * (256 - amount) >> 8;
+  b = b * (256 - amount) >> 8;
+  return KDColor::RGB888(r, g, b);
+}
+
+void drawHead(Band& b, const Mii& m, int cx, int cy, int h, bool happy) {
+  KDColor skin = rgb(k_skinColors[m.skin % k_skins]);
+  KDColor hair = rgb(k_hairColorValues[m.hairColor % k_hairColors]);
+  int style = m.hair % k_hairStyles;
+  // Hair behind the head
+  if (style == 1) {
+    roundFill(b, {cx - u(h, 56), cy - u(h, 60), u(h, 112), u(h, 118)},
+              u(h, 42), hair);
+  } else if (style == 4) {
+    ellipse(b, {cx - u(h, 74), cy - u(h, 86), u(h, 148), u(h, 132)}, hair);
+  } else if (style == 5) {
+    disc(b, cx - u(h, 58), cy + u(h, 6), u(h, 20), hair);
+    disc(b, cx + u(h, 58), cy + u(h, 6), u(h, 20), hair);
+  }
+  // Ears and face
+  disc(b, cx - u(h, 49), cy + u(h, 6), u(h, 11) + 1, skin);
+  disc(b, cx + u(h, 49), cy + u(h, 6), u(h, 11) + 1, skin);
+  ellipse(b, {cx - u(h, 50), cy - u(h, 56), u(h, 100), u(h, 112)}, skin);
+  // Hair on top, the forehead cut out of it
+  if (style == 6) {
+    disc(b, cx - u(h, 46), cy - u(h, 12), u(h, 12), hair);
+    disc(b, cx + u(h, 46), cy - u(h, 12), u(h, 12), hair);
+  } else {
+    ellipse(b, {cx - u(h, 54), cy - u(h, 68), u(h, 108), u(h, 66)}, hair);
+    Rect forehead = {cx - u(h, 42), cy - u(h, 40), u(h, 84), u(h, 64)};
+    if (style == 2 || style == 5) {
+      forehead = {cx - u(h, 44), cy - u(h, 22), u(h, 88), u(h, 52)};
+    } else if (style == 3) {
+      forehead = {cx - u(h, 30), cy - u(h, 40), u(h, 76), u(h, 64)};
+    }
+    ellipse(b, forehead, skin);
+  }
+  // Eyebrows
+  int browY = cy - u(h, 13);
+  int browH = u(h, 4) > 1 ? u(h, 4) : 1;
+  fill(b, {cx - u(h, 27), browY, u(h, 16), browH}, hair);
+  fill(b, {cx + u(h, 11), browY, u(h, 16), browH}, hair);
+  // Eyes
+  KDColor ink = rgb(0x262626);
+  int ey = cy + u(h, 1);
+  int eyes = happy ? 2 : m.eyes % k_eyeStyles;
+  for (int side = -1; side <= 1; side += 2) {
+    int ex = cx + side * u(h, 19);
+    switch (eyes) {
+      case 0:
+        ellipse(b, {ex - u(h, 5), ey - u(h, 8), u(h, 10) + 1, u(h, 16) + 1},
+                ink);
+        break;
+      case 1:
+        ellipse(b, {ex - u(h, 9), ey - u(h, 8), u(h, 18) + 1, u(h, 16) + 1},
+                KDColor::RGB24(0xFFFFFF));
+        disc(b, ex, ey + 1, u(h, 5) + 1, ink);
+        break;
+      case 2:
+        ellipse(b, {ex - u(h, 8), ey - u(h, 5), u(h, 16) + 1, u(h, 12) + 1},
+                ink);
+        ellipse(b, {ex - u(h, 9), ey - u(h, 2), u(h, 18) + 1, u(h, 12) + 1},
+                skin);
+        break;
+      default:
+        ellipse(b, {ex - u(h, 7), ey - u(h, 10), u(h, 14) + 1, u(h, 20) + 1},
+                ink);
+        disc(b, ex - u(h, 2), ey - u(h, 4), u(h, 3) + 1,
+             KDColor::RGB24(0xFFFFFF));
+        break;
+    }
+  }
+  // Nose
+  ellipse(b, {cx - u(h, 5), cy + u(h, 10), u(h, 10) + 1, u(h, 7) + 1},
+          darker(k_skinColors[m.skin % k_skins], 40));
+  // Mouth
+  int my = cy + u(h, 27);
+  int mouth = happy ? 3 : m.mouth % k_mouthStyles;
+  KDColor lips = rgb(0xC0403A);
+  switch (mouth) {
+    case 0:
+      ellipse(b, {cx - u(h, 13), my - u(h, 6), u(h, 26) + 1, u(h, 14) + 1},
+              lips);
+      ellipse(b, {cx - u(h, 15), my - u(h, 11), u(h, 30) + 1, u(h, 14) + 1},
+              skin);
+      break;
+    case 1:
+      ellipse(b, {cx - u(h, 7), my - u(h, 5), u(h, 14) + 1, u(h, 12) + 1},
+              rgb(0x7A1E1E));
+      break;
+    case 2:
+      fill(b, {cx - u(h, 10), my, u(h, 20) + 1, u(h, 3) > 1 ? u(h, 3) : 1},
+           lips);
+      break;
+    default:
+      ellipse(b, {cx - u(h, 16), my - u(h, 8), u(h, 32) + 1, u(h, 18) + 1},
+              rgb(0x7A1E1E));
+      fill(b, {cx - u(h, 12), my - u(h, 6), u(h, 24) + 1, u(h, 5) + 1},
+           KDColor::RGB24(0xFFFFFF));
+      ellipse(b, {cx - u(h, 18), my - u(h, 16), u(h, 36) + 1, u(h, 12) + 1},
+              skin);
+      break;
+  }
+  // Glasses
+  int g = m.glasses % k_glasses;
+  if (g != 0) {
+    KDColor frameColor = rgb(0x333333);
+    for (int side = -1; side <= 1; side += 2) {
+      Rect lens = {cx + side * u(h, 19) - u(h, 13), ey - u(h, 11), u(h, 26) + 1,
+                   u(h, 22) + 1};
+      if (g == 2) {
+        roundFill(b, lens, u(h, 8), rgb(0x202020), 235);
+      } else {
+        roundFrame(b, lens, u(h, 9), frameColor);
+      }
+    }
+    fill(b, {cx - u(h, 6), ey - u(h, 4), u(h, 12) + 1, 1}, frameColor);
+  }
+}
+
+}  // namespace
+
+uint32_t favoriteColor(int i) { return k_favorites[i % k_favoriteColors]; }
+const char* favoriteColorName(int i) {
+  return k_favoriteNames[i % k_favoriteColors];
+}
+const char* hairStyleName(int i) { return k_hairNames[i % k_hairStyles]; }
+
+void drawMiiBust(Band& b, const Mii& m, int cx, int cy, int size,
+                 bool happy) {
+  if (!Rect{cx - size, cy - size, 2 * size, 2 * size + size}.intersects(
+          b.clip())) {
+    return;
+  }
+  KDColor shirt = rgb(favoriteColor(m.color));
+  ellipse(b, {cx - u(size, 64), cy + u(size, 44), u(size, 128), u(size, 100)},
+          shirt);
+  // Collar
+  ellipse(b, {cx - u(size, 16), cy + u(size, 44), u(size, 32), u(size, 14)},
+          rgb(k_skinColors[m.skin % k_skins]));
+  drawHead(b, m, cx, cy, size, happy);
+}
+
+void drawMiiBody(Band& b, const Mii& m, int cx, int feetY, int size, int step,
+                 bool facingLeft) {
+  int h = size;
+  if (!Rect{cx - h, feetY - 3 * h, 2 * h, 3 * h + 2}.intersects(b.clip())) {
+    return;
+  }
+  (void)facingLeft;
+  KDColor shirt = rgb(favoriteColor(m.color));
+  KDColor pants = rgb(0x3A4A6A);
+  KDColor skin = rgb(k_skinColors[m.skin % k_skins]);
+  int swing = (step % 4 == 1) ? 1 : ((step % 4 == 3) ? -1 : 0);
+  int legW = u(h, 22) > 2 ? u(h, 22) : 2;
+  int legH = u(h, 60);
+  // Legs (one forward, one back while walking)
+  fill(b, {cx - u(h, 26), feetY - legH - swing, legW, legH + swing}, pants);
+  fill(b, {cx + u(h, 4), feetY - legH + swing, legW, legH - swing}, pants);
+  fill(b, {cx - u(h, 30), feetY - 2 - swing, legW + 3, 2}, rgb(0x303030));
+  fill(b, {cx + u(h, 2), feetY - 2 + swing, legW + 3, 2}, rgb(0x303030));
+  // Body and arms
+  int bodyTop = feetY - legH - u(h, 74);
+  roundFill(b, {cx - u(h, 36), bodyTop, u(h, 72), u(h, 78)}, u(h, 18), shirt);
+  disc(b, cx - u(h, 42), bodyTop + u(h, 40) + swing * 2, u(h, 11) + 1, skin);
+  disc(b, cx + u(h, 42), bodyTop + u(h, 40) - swing * 2, u(h, 11) + 1, skin);
+  drawHead(b, m, cx, bodyTop - u(h, 50), h, false);
+}
+
+void randomMii(Mii* m, uint32_t seed) {
+  uint32_t x = seed * 2654435761u + 0x9E3779B9u;
+  auto next = [&x](int n) {
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    return static_cast<uint8_t>(x % n);
+  };
+  m->skin = next(k_skins);
+  m->hair = next(k_hairStyles);
+  m->hairColor = next(k_hairColors);
+  m->eyes = next(k_eyeStyles);
+  m->mouth = next(k_mouthStyles);
+  m->color = next(k_favoriteColors);
+  m->glasses = next(5) == 0 ? 1 + next(2) : 0;
+  strlcpy(m->name, "Mii", Mii::k_nameSize);
+}
+
+const Mii& friendMii(int i) {
+  if (!s_friendsReady) {
+    for (int k = 0; k < k_numberOfFriends; k++) {
+      randomMii(&s_friends[k], 17 + k * 31);
+      strlcpy(s_friends[k].name, k_friendNames[k], Mii::k_nameSize);
+    }
+    // The maths teachers look the part
+    s_friends[8].glasses = 1;
+    s_friends[8].hair = 1;
+    s_friends[8].hairColor = 4;
+    s_friends[8].color = 8;
+    s_friends[9].glasses = 1;
+    s_friends[9].hair = 6;
+    s_friends[9].hairColor = 7;
+    s_friends[9].color = 5;
+    s_friendsReady = true;
+  }
+  return s_friends[i % k_numberOfFriends];
+}
+
+const char* friendName(int i) { return k_friendNames[i % k_numberOfFriends]; }
+
+}  // namespace WiiU
+}  // namespace Home
diff --git a/epsilon/apps/home/wiiu/mii.h b/epsilon/apps/home/wiiu/mii.h
new file mode 100644
index 0000000000..f47b66f295
--- /dev/null
+++ b/epsilon/apps/home/wiiu/mii.h
@@ -0,0 +1,52 @@
+#pragma once
+
+/* The Miis of Wii U-OS: drawn with shapes (no pictures), from a few bytes of
+ * features, at any size. Yours is made in Mii Maker; the friends are made
+ * from their index. */
+
+#include <stdint.h>
+
+#include "gfx.h"
+
+namespace Home {
+namespace WiiU {
+
+struct Mii {
+  constexpr static int k_nameSize = 11;
+  uint8_t skin;       // k_skins
+  uint8_t hair;       // style, k_hairStyles
+  uint8_t hairColor;  // k_hairColors
+  uint8_t eyes;       // k_eyeStyles
+  uint8_t mouth;      // k_mouthStyles
+  uint8_t color;      // favourite colour (shirt), k_favoriteColors
+  uint8_t glasses;    // 0 none, 1 round, 2 sun
+  char name[k_nameSize];
+};
+
+constexpr int k_skins = 6;
+constexpr int k_hairStyles = 7;
+constexpr int k_hairColors = 8;
+constexpr int k_eyeStyles = 4;
+constexpr int k_mouthStyles = 4;
+constexpr int k_favoriteColors = 12;
+constexpr int k_glasses = 3;
+
+uint32_t favoriteColor(int i);
+const char* favoriteColorName(int i);
+const char* hairStyleName(int i);
+
+// Head and shoulders; the head is size pixels wide, centred on (cx, cy)
+void drawMiiBust(Band& b, const Mii& m, int cx, int cy, int size,
+                 bool happy = false);
+// Whole Mii standing (for the plaza), feet at (cx, feetY), head size wide
+void drawMiiBody(Band& b, const Mii& m, int cx, int feetY, int size,
+                 int step, bool facingLeft);
+
+// The friends (always the same ones, made from their index)
+constexpr int k_numberOfFriends = 10;
+const Mii& friendMii(int i);
+const char* friendName(int i);
+void randomMii(Mii* m, uint32_t seed);
+
+}  // namespace WiiU
+}  // namespace Home
