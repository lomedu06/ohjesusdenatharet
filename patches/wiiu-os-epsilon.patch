+static void softShape(Band& b, int cx, int cy, int rx, int ry, KDColor c,
+                      int alpha) {
+  const Rect& clip = b.clip();
+  int y0 = cy - ry > clip.y ? cy - ry : clip.y;
+  int y1 = cy + ry < clip.bottom() ? cy + ry : clip.bottom();
+  for (int y = y0; y < y1; y++) {
+    float dy = (y + 0.5f - cy) / ry;
+    int hw = static_cast<int>(rx * sqrtf(1.f - dy * dy));
+    // Fading edges: a wider, lighter span under the shape
+    fill(b, {cx - hw - 6, y, 2 * hw + 12, 1}, c, alpha / 3);
+    fill(b, {cx - hw, y, 2 * hw, 1}, c, alpha);
+  }
+}
