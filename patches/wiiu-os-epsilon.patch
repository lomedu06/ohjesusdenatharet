+namespace Apps {
+
+void initialize() {
+  MiiverseState& m = s.miiverse;
+  m.count = 0;
+  for (int i = 0; i < 8; i++) {
+    Post p = {static_cast<uint8_t>(i % k_numberOfFriends),
+              static_cast<uint8_t>(i % 6),
+              static_cast<uint8_t>(i * 3 % k_numberOfPostTexts),
+              0,
+              static_cast<uint16_t>(2 + i * 7 % 23),
+              false,
+              static_cast<uint16_t>(5 + i * 11)};
+    m.posts[m.count++] = p;
+  }
+  m.calcSeen = Calc::count();
+  s.drawing.x = DrawingState::k_width / 2;
+  s.drawing.y = DrawingState::k_height / 2;
+  s.parental.pending = {Slot::Kind::Empty, 0};
+}
+
+void updateMiiverse() {
+  MiiverseState& m = s.miiverse;
+  uint8_t count = Calc::count();
+  int fresh = static_cast<uint8_t>(count - m.calcSeen);
+  if (fresh > Calc::k_capacity) {
+    fresh = Calc::k_capacity;
+  }
+  for (int i = fresh - 1; i >= 0; i--) {
+    // text: the serial number of the result (see postText)
+    insertPost({0xFF, k_communityCalc, static_cast<uint8_t>(count - 1 - i), 1,
+                static_cast<uint16_t>(randomInt(4)), false, 0});
+  }
+  if (fresh > 0) {
+    addNotification(1, 0);
+  }
+  m.calcSeen = count;
+}
+
+void enter(Applet a) {
+  s_seed ^= now() * 2654435761u + 1;
+  switch (a) {
+    case Applet::MiiMaker:
+      s.miiMaker.editing = false;
+      break;
+    case Applet::Settings:
+      s.settings.formatAsked = false;
+      break;
+    case Applet::WiiMode:
+      s.wii.phase = 0;
+      s.wii.start = now();
+      s.wii.message = 0;
+      break;
+    case Applet::Plaza:
+      if (!s.plaza.ready) {
+        plazaSetup();
+      }
+      s.plaza.zoom = false;
+      break;
+    case Applet::Miiverse: {
+      // Friends react to your posts
+      MiiverseState& m = s.miiverse;
+      for (int i = 0; i < m.count; i++) {
+        if (m.posts[i].author == 0xFF && randomInt(2) == 0) {
+          m.posts[i].yeahs++;
+          addNotification(5, static_cast<uint8_t>(randomInt(k_numberOfFriends)));
+          break;
+        }
+      }
+      if (m.selected >= m.count) {
+        m.selected = 0;
+      }
+      break;
+    }
+    case Applet::Notifications:
+      s.notifications.unread = 0;
+      s.notifications.selected = 0;
+      break;
+    case Applet::Browser:
+      s.browser.page = 0;
+      break;
+    case Applet::Shop:
+      s.shop.message = 0;
+      if (s.shop.selected >= shopCount()) {
+        s.shop.selected = 0;
+      }
+      break;
+    case Applet::Friends:
+      s.friends.profile = false;
+      break;
+    case Applet::Activity:
+      s.activity.scroll = 0;
+      break;
+    case Applet::Parental:
+      s.parental.row = 0;
+      break;
+    default:
+      break;
+  }
+}
+
+bool handleEvent(Applet a, Event e) {
+  switch (a) {
+    case Applet::MiiMaker:
+      return miiMakerEvent(e);
+    case Applet::Settings:
+      return settingsEvent(e);
+    case Applet::Activity:
+      return activityEvent(e);
+    case Applet::Parental:
+      return parentalEvent(e);
+    case Applet::Health:
+      return healthEvent(e);
+    case Applet::WiiMode:
+      return wiiEvent(e);
+    case Applet::Plaza:
+      return plazaEvent(e);
+    case Applet::Miiverse:
+      return miiverseEvent(e);
+    case Applet::Friends:
+      return friendsEvent(e);
+    case Applet::Shop:
+      return shopEvent(e);
+    case Applet::Browser:
+      return browserEvent(e);
+    case Applet::Notifications:
+      return notificationsEvent(e);
+    case Applet::Downloads:
+      return downloadsEvent(e);
+    case Applet::Drawing:
+      return drawingEvent(e);
+    default:
+      return false;
+  }
+}
+
+bool animated(Applet a) {
+  switch (a) {
+    case Applet::Plaza:
+      return !s.plaza.zoom;
+    case Applet::WiiMode:
+      return true;
+    case Applet::Downloads:
+      return s.downloads.started && !s.downloads.done;
+    case Applet::Browser:
+      return s.browser.page == 1;
+    case Applet::MiiMaker:
+      return s.miiMaker.editing;
+    default:
+      return false;
+  }
+}
+
+bool frame(Applet a) {
+  switch (a) {
+    case Applet::Plaza:
+      return plazaFrame();
+    case Applet::WiiMode:
+      if (s.wii.phase == 0) {
+        if (now() - s.wii.start > 1800) {
+          s.wii.phase = 1;
+        }
+        invalidateAll();
+        return true;
+      }
+      if (now() % 1000 < 40) {
+        invalidate({0, 160, k_screenWidth, 80});
+        return true;
+      }
+      return false;
+    case Applet::Downloads:
+      return downloadsFrame();
+    case Applet::Browser:
+      if (s.browser.page == 1 && now() - s.browser.loadStart > 1800) {
+        s.browser.page = 2;
+      }
+      invalidateAll();
+      return true;
+    case Applet::MiiMaker:
+      invalidate({146, k_top + 8, 164, 18});
+      return true;
+    default:
+      return false;
+  }
+}
+
+void chrome(Band& b, Applet a, const char* hints) {
+  vgradient(b, {0, 0, k_screenWidth, k_top}, rgb(0xFFFFFF), rgb(0xE6EAED));
+  fill(b, {0, k_top - 1, k_screenWidth, 1}, rgb(0xC4CACF));
+  image(b, appletIcon(a), 5, 3, 24);
+  text(b, appletTitle(a), 34, 6, k_ink, Large);
+  char buffer[8];
+  timeText(buffer, sizeof(buffer), clockMinutes());
+  text(b, buffer, 312, 8, k_inkLight, Small, Align::Right);
+  if (hints) {
+    hintBar(b, hints);
+  }
+}
+
+void render(Applet a, Band& b) {
+  if (a == Applet::Plaza) {
+    plazaRender(b);
+    return;
+  }
+  if (a == Applet::WiiMode) {
+    wiiRender(b);
+    return;
+  }
+  background(b);
+  chrome(b, a, nullptr);
+  switch (a) {
+    case Applet::MiiMaker:
+      miiMakerRender(b);
+      break;
+    case Applet::Settings:
+      settingsRender(b);
+      break;
+    case Applet::Activity:
+      activityRender(b);
+      break;
+    case Applet::Parental:
+      parentalRender(b);
+      break;
+    case Applet::Health:
+      healthRender(b);
+      break;
+    case Applet::Miiverse:
+      miiverseRender(b);
+      break;
+    case Applet::Friends:
+      friendsRender(b);
+      break;
+    case Applet::Shop:
+      shopRender(b);
+      break;
+    case Applet::Browser:
+      browserRender(b);
+      break;
+    case Applet::Notifications:
+      notificationsRender(b);
+      break;
+    case Applet::Downloads:
+      downloadsRender(b);
+      break;
+    case Applet::Drawing:
+      drawingRender(b);
+      break;
+    default:
+      break;
+  }
+}
