+void image(Band& b, int icon, int x, int y, int size, int alpha) {
+  const WiiUIcons::Image& im = WiiUIcons::k_images[icon];
+  int w = im.width, h = im.height;
+  int dw = size > 0 ? size : w;
+  int dh = size > 0 ? size * h / w : h;
+  Rect z = Rect{x, y, dw, dh}.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  int step = (w << 16) / dw;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    int sy = (yy - y) * h / dh;
+    const uint16_t* colors = im.colors + sy * w;
+    const uint8_t* alphas = im.alphas + sy * w;
+    int fx = (z.x - x) * step;
+    for (int xx = z.x; xx < z.right(); xx++, fx += step) {
+      int sx = fx >> 16;
+      int a = alphas[sx];
+      if (a) {
+        blendPixel(row + xx, KDColor::RGB16(colors[sx]),
+                   a == 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void tinted(Band& b, int icon, int x, int y, KDColor c, int alpha) {
+  const WiiUIcons::Image& im = WiiUIcons::k_images[icon];
+  Rect z = Rect{x, y, im.width, im.height}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const uint8_t* alphas = im.alphas + (yy - y) * im.width - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = alphas[xx];
+      if (a) {
+        blendPixel(row + xx, c, a == 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
