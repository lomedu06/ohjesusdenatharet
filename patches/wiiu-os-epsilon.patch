+
+void selectInGrid(int index) {
+  bool samePage = s.focus == Focus::Grid && pageOf(index) == currentPage() &&
+                  !s.moving;
+  if (samePage) {
+    invalidate(selectionFrame(s.selected).inset(-3));
+    invalidate(selectionFrame(index).inset(-3));
+    invalidate(k_titleArea);
+  } else {
+    invalidateAll();
+  }
+  s.selected = index;
+  s.focus = Focus::Grid;
+}
+
+int nearestColumnFromX(int x) {
+  int c = (x - k_gridX + k_tileStepX / 2 - k_tileSize / 2) / k_tileStepX;
+  return c < 0 ? 0 : (c >= k_columns ? k_columns - 1 : c);
+}
+
+void moveSelection(int dx, int dy) {
+  int page = currentPage();
+  int r = rowOf(s.selected);
+  int c = columnOf(s.selected);
+  int pages = numberOfPages();
+  if (dx > 0) {
+    if (c < k_columns - 1) {
+      c++;
+    } else if (page + 1 < pages) {
+      page++;
+      c = 0;
+    }
+  } else if (dx < 0) {
+    if (c > 0) {
+      c--;
+    } else if (page > 0) {
+      page--;
+      c = k_columns - 1;
+    }
+  } else if (dy < 0) {
+    if (r > 0) {
+      r--;
+    } else if (!s.moving) {
+      s.focus = Focus::Avatar;
+      invalidateAll();
+      return;
+    }
+  } else if (dy > 0) {
+    if (r < k_rows - 1) {
+      r++;
+    } else if (!s.moving) {
+      s.focus = Focus::Dock;
+      int x = tileRect(s.selected).x + k_tileSize / 2;
+      int best = 0;
+      for (int i = 0; i < k_dockItems; i++) {
+        int d = dockX(i) + k_dockIcon / 2 - x;
+        int db = dockX(best) + k_dockIcon / 2 - x;
+        if ((d < 0 ? -d : d) < (db < 0 ? -db : db)) {
+          best = i;
+        }
+      }
+      s.dock = best;
+      invalidateAll();
+      return;
+    }
+  }
+  int target = page * k_slotsPerPage + r * k_columns + c;
+  if (s.moving && target != s.selected) {
+    Slot t = s.slots[target];
+    s.slots[target] = s.slots[s.selected];
+    s.slots[s.selected] = t;
+  }
+  selectInGrid(target);
+}
+
+bool handleMenuEvent(Event e) {
+  if (s.focus == Focus::Avatar) {
+    if (e == Events::Right || e == Events::Down) {
+      selectInGrid(currentPage() * k_slotsPerPage);
+    } else if (e == Events::OK || e == Events::EXE) {
+      openApplet(Applet::MiiMaker);
+    } else {
+      return e.isKeyboardEvent() && e != Events::OnOff;
+    }
+    return true;
+  }
+  if (s.focus == Focus::Dock) {
+    if (e == Events::Left && s.dock > 0) {
+      s.dock--;
+    } else if (e == Events::Right && s.dock < k_dockItems - 1) {
+      s.dock++;
+    } else if (e == Events::Up) {
+      int x = dockX(s.dock) + k_dockIcon / 2;
+      selectInGrid(currentPage() * k_slotsPerPage +
+                   (k_rows - 1) * k_columns + nearestColumnFromX(x));
+      return true;
+    } else if (e == Events::OK || e == Events::EXE) {
+      openApplet(k_dock[s.dock]);
+      return true;
+    } else {
+      return e.isKeyboardEvent() && e != Events::OnOff;
+    }
+    invalidateAll();
+    return true;
+  }
+  // Grid
+  if (e == Events::Left) {
+    moveSelection(-1, 0);
+  } else if (e == Events::Right) {
+    moveSelection(1, 0);
+  } else if (e == Events::Up) {
+    moveSelection(0, -1);
+  } else if (e == Events::Down) {
+    moveSelection(0, 1);
+  } else if (e == Events::Toolbox) {
+    // Pick up / drop a tile, like holding a tile on the GamePad
+    if (s.moving || !s.slots[s.selected].isEmpty()) {
+      s.moving = !s.moving;
+      invalidateAll();
+    }
+  } else if (e == Events::OK || e == Events::EXE) {
+    if (s.moving) {
+      s.moving = false;
+      invalidateAll();
+    } else if (!s.slots[s.selected].isEmpty()) {
+      launchSlot(s.slots[s.selected]);
+    }
+  } else if (e == Events::Back) {
+    if (s.moving) {
+      s.moving = false;
+      invalidateAll();
+    } else if (currentPage() != 0) {
+      selectInGrid(0);
+    }
+  } else if (e == Events::Home) {
+    s.moving = false;
+    selectInGrid(0);
+  } else if (e == Events::Var) {
+    // The TV button of the GamePad: the Mii plaza
+    openApplet(Applet::Plaza);
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  return true;
+}
