+bool settingsEvent(Event e) {
+  SettingsState& st = s.settings;
+  if (st.formatAsked) {
+    if ((e == Events::OK || e == Events::EXE) && st.formatAnswer == 0) {
+      st.formatAnswer = 1;
+    } else if (e == Events::Back || e == Events::OK || e == Events::EXE) {
+      st.formatAsked = false;
+      st.formatAnswer = 0;
+    }
+    invalidateAll();
+    return true;
+  }
+  int d = e == Events::Left ? -1 : (e == Events::Right ? 1 : 0);
+  if (e == Events::Up && st.row > 0) {
+    st.row--;
+  } else if (e == Events::Down && st.row < k_settingsRows - 1) {
+    st.row++;
+  } else if (d != 0) {
+    switch (st.row) {
+      case 0: {
+        int max = Ion::Backlight::MaxBrightness;
+        int level = brightness() + d * max / 10;
+        setBrightness(level < 8 ? 8 : (level > max ? max : level));
+        break;
+      }
+      case 1:
+        s.accent = (s.accent + d + k_numberOfAccents) % k_numberOfAccents;
+        break;
+      case 2:
+        s.background =
+            (s.background + d + k_numberOfBackgrounds) % k_numberOfBackgrounds;
+        break;
+      case 3:
+        s.clockOffsetMinutes = (s.clockOffsetMinutes + d * 5 + 1440) % 1440;
+        break;
+      default:
+        break;
+    }
+  } else if (e == Events::OK || e == Events::EXE) {
+    if (st.row == 5) {
+      int index = builtinIndexOfName(
+          static_cast<int>(I18n::Message::SettingsApp));
+      if (index >= 0) {
+        closeApplet();
+        launchSlot({Slot::Kind::Builtin, static_cast<int8_t>(index)});
+      }
+      return true;
+    }
+    if (st.row == 6) {
+      st.formatAsked = true;
+      st.formatAnswer = 0;
+    }
+  } else if (e == Events::Back) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
