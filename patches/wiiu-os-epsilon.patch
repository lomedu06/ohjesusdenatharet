+const char* friendActivity(int i) {
+  constexpr const char* k[] = {"Calculs",  "Grapheur", "Menu Wii U",
+                               "Python",   "Place Mii", "Mode Wii",
+                               "Miiverse", "Équations"};
+  if (numberOfGames() > 0 && i % 3 == 1) {
