+/* ========================================================== Mii plaza */
+
+constexpr int k_plazaTop = 92;
+constexpr int k_plazaBottom = 212;
+
+void plazaTarget(PlazaMii& m) {
+  // Somewhere on the plaza, not in the middle (the tiles are there)
+  for (int tries = 0; tries < 8; tries++) {
+    int x = 20 + randomInt(280);
+    int y = k_plazaTop + randomInt(k_plazaBottom - k_plazaTop);
+    int dx = x - 160, dy = (y - 150) * 2;
+    if (dx * dx + dy * dy > 60 * 60) {
+      m.tx = x * 16;
+      m.ty = y * 16;
+      return;
+    }
+  }
+  m.tx = (randomInt(2) ? 40 : 280) * 16;
+  m.ty = (k_plazaTop + 20) * 16;
+}
+
+void plazaSetup() {
+  PlazaState& p = s.plaza;
+  for (int i = 0; i < PlazaState::k_miis; i++) {
+    PlazaMii& m = p.miis[i];
+    m.who = i == 0 ? 0xFF : static_cast<uint8_t>(i - 1);
+    plazaTarget(m);
+    m.x = m.tx;
+    m.y = m.ty;
+    plazaTarget(m);
+    m.bubbleText = static_cast<uint8_t>(randomInt(k_numberOfPostTexts));
+    m.bubbleUntil = static_cast<uint16_t>(i % 4 == 1 ? 40 + randomInt(60) : 0);
+    m.step = 0;
+  }
+  p.ready = true;
+}
+
+const Mii& plazaMii(const PlazaMii& m) {
+  return m.who == 0xFF ? s.me : friendMii(m.who);
+}
+
+int plazaBubbles() {
+  int n = 0;
+  for (const PlazaMii& m : s.plaza.miis) {
+    n += m.bubbleUntil > 0;
+  }
+  return n;
+}
+
+bool plazaFrame() {
+  PlazaState& p = s.plaza;
+  if (p.zoom) {
+    return false;
+  }
+  p.frame++;
+  for (int i = 0; i < PlazaState::k_miis; i++) {
+    PlazaMii& m = p.miis[i];
+    int dx = m.tx - m.x, dy = m.ty - m.y;
+    if (dx == 0 && dy == 0) {
+      if (randomInt(40) == 0) {
+        plazaTarget(m);
+      }
+    } else {
+      int speed = 12;
+      m.x += dx > speed ? speed : (dx < -speed ? -speed : dx);
+      m.y += dy > speed / 2 ? speed / 2 : (dy < -speed / 2 ? -speed / 2 : dy);
+      if (p.frame % 4 == 0) {
+        m.step++;
+      }
+    }
+    if (m.bubbleUntil > 0) {
+      m.bubbleUntil--;
+    } else if (randomInt(220) == 0 && plazaBubbles() < 2) {
+      m.bubbleText = static_cast<uint8_t>(randomInt(k_numberOfPostTexts));
+      m.bubbleUntil = 70;
+    }
+  }
+  invalidate({0, 40, k_screenWidth, k_screenHeight - 40});
+  return true;
+}
+
+void plazaRender(Band& b) {
+  PlazaState& p = s.plaza;
+  // Sky, then the plaza seen from above at an angle
+  vgradient(b, {0, 0, k_screenWidth, 80}, rgb(0x8FD3F7), rgb(0xD9F1FC));
+  vgradient(b, {0, 80, k_screenWidth, 160}, rgb(0x9DDB72), rgb(0x5DB843));
+  ellipse(b, {-20, 70, 360, 170}, rgb(0xB6E58C));
+  ellipse(b, {50, 104, 220, 96}, rgb(0xF3EBD6));
+  ellipse(b, {80, 118, 160, 66}, rgb(0xE8DDC2));
+  // Clouds and trees far away
+  ellipse(b, {30, 16, 60, 18}, k_white, 220);
+  ellipse(b, {50, 10, 40, 18}, k_white, 220);
+  ellipse(b, {220, 28, 70, 16}, k_white, 200);
+  for (int i = 0; i < 9; i++) {
+    disc(b, 10 + i * 38, 80, 12, rgb(0x3E9A3A));
+  }
+  // The tiles of the menu in the middle of the plaza
+  int shown = 0;
+  for (int i = 0; i < k_maxSlots && shown < 3; i++) {
+    if (!s.slots[i].isEmpty()) {
+      int x = 118 + shown * 30;
+      roundFill(b, {x - 2, 122, 28, 28}, 6, k_white);
+      drawSlotArt(b, s.slots[i], x, 124, 24);
+      shown++;
+    }
+  }
+  // Miis, from the back to the front
+  int order[PlazaState::k_miis];
+  for (int i = 0; i < PlazaState::k_miis; i++) {
+    order[i] = i;
+  }
+  for (int i = 1; i < PlazaState::k_miis; i++) {
+    int k = order[i], j = i - 1;
+    while (j >= 0 && p.miis[order[j]].y > p.miis[k].y) {
+      order[j + 1] = order[j];
+      j--;
+    }
+    order[j + 1] = k;
+  }
+  for (int k = 0; k < PlazaState::k_miis; k++) {
+    const PlazaMii& m = p.miis[order[k]];
+    int x = m.x / 16, y = m.y / 16;
+    int size = 12 + (y - k_plazaTop) * 9 / (k_plazaBottom - k_plazaTop);
+    ellipse(b, {x - size / 2 - 2, y - 2, size + 4, 4}, rgb(0x000000), 50);
+    drawMiiBody(b, plazaMii(m), x, y, size, m.step, m.tx < m.x);
+    if (order[k] == p.selected) {
+      int top = y - size * 3 - 4;
+      tinted(b, WiiUIcons::IconHomeGlyph, x - 6, top - 13, accent());
+    }
+  }
+  // Speech bubbles on top
+  for (int i = 0; i < PlazaState::k_miis; i++) {
+    const PlazaMii& m = p.miis[i];
+    if (m.bubbleUntil == 0) {
+      continue;
+    }
+    int x = m.x / 16, y = m.y / 16;
+    int size = 12 + (y - k_plazaTop) * 9 / (k_plazaBottom - k_plazaTop);
+    const char* t = k_postTexts[m.bubbleText % k_numberOfPostTexts];
+    char shortText[20];
+    strlcpy(shortText, t, sizeof(shortText));
+    if (strlen(t) >= sizeof(shortText)) {
+      memcpy(shortText + sizeof(shortText) - 4, "...", 4);
+    }
+    int w = textWidth(shortText) + 10;
+    int bx = x - w / 2;
+    bx = bx < 2 ? 2 : (bx + w > 318 ? 318 - w : bx);
+    int by = y - size * 3 - 22;
+    roundFill(b, {bx, by, w, 17}, 8, k_white, 235);
+    text(b, shortText, bx + 5, by + 2, k_ink);
+  }
+  // Title
+  roundFill(b, {6, 6, 92, 22}, 11, k_white, 220);
+  image(b, WiiUIcons::IconPlaza, 9, 8, 18);
+  text(b, "Place Mii", 30, 10, k_ink);
+  if (p.zoom) {
+    const PlazaMii& m = p.miis[p.selected];
+    fill(b, k_screen, rgb(0x000000), 110);
+    Rect d = {30, 40, 260, 150};
+    panel(b, d);
+    roundFill(b, {d.x + 10, d.y + 10, 80, 80}, 40, rgb(0xEEF2F5));
+    if (b.setClip({d.x + 10, d.y + 10, 80, 80})) {
+      drawMiiBust(b, plazaMii(m), d.x + 50, d.y + 46, 40, true);
+    }
+    b.resetClip();
+    text(b, plazaMii(m).name, d.x + 100, d.y + 14, k_ink, Large);
+    text(b, m.who == 0xFF ? "C'est toi !" : "En ligne", d.x + 100, d.y + 36,
+         m.who == 0xFF ? accent() : rgb(0x2EB82E));
+    paragraph(b, k_postTexts[m.bubbleText % k_numberOfPostTexts], d.x + 12,
+              d.y + 100, 34, k_ink, 3, 14);
+  } else {
+    roundFill(b, {6, 214, 308, 20}, 10, k_white, 210);
+    text(b, "Gauche/Droite : un Mii   OK : son message", 160, 217, k_ink,
+         Small, Align::Center);
+  }
+}
+
+bool plazaEvent(Event e) {
+  PlazaState& p = s.plaza;
+  if (p.zoom) {
+    if (e == Events::Back || e == Events::OK || e == Events::EXE) {
+      p.zoom = false;
+      invalidateAll();
+      return true;
+    }
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  if (e == Events::Left || e == Events::Up) {
+    p.selected = (p.selected + PlazaState::k_miis - 1) % PlazaState::k_miis;
+  } else if (e == Events::Right || e == Events::Down) {
+    p.selected = (p.selected + 1) % PlazaState::k_miis;
+  } else if (e == Events::OK || e == Events::EXE) {
+    p.zoom = true;
+  } else if (e == Events::Back || e == Events::Var) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
