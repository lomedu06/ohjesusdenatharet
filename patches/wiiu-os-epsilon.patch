+    roundFrame(b, r, 8, k_line);
+    bool game = i < numberOfGames();
+    if (game) {
+      drawSlotArt(b, {Slot::Kind::External, static_cast<int8_t>(i)}, r.x + 4,
+                  r.y + 4, 25);
+      text(b, gameName(i), r.x + 36, r.y + 9, k_ink, Small, Align::Left, 180);
+      text(b, "Installé", r.right() - 8, r.y + 9, rgb(0x2EB82E), Small,
+           Align::Right);
+    } else {
+      const ShopItem& it = k_shopItems[i - numberOfGames()];
+      image(b, it.icon, r.x + 4, r.y + 4, 25);
+      text(b, it.name, r.x + 36, r.y + 9, k_ink, Small, Align::Left, 190);
+      roundFill(b, {r.right() - 84, r.y + 7, 78, 19}, 9, rgb(0xFF8A1F));
+      text(b, it.price, r.right() - 45, r.y + 9, k_white, Small,
