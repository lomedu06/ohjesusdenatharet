+void addNotification(uint8_t kind, uint8_t arg) {
+  NotificationsState& n = s.notifications;
+  for (int i = NotificationsState::k_count - 1; i > 0; i--) {
+    n.items[i] = n.items[i - 1];
+  }
+  n.items[0] = {kind, arg, static_cast<uint16_t>(clockMinutes())};
+  if (n.count < NotificationsState::k_count) {
+    n.count++;
+  }
+  if (n.unread < 99) {
+    n.unread++;
+  }
+  // The blue light of the Wii disc slot, when a message arrives
+  if (!s_fakeClock) {
+    Ion::LED::setColor(KDColor::RGB24(0x0060FF));
+  }
+  n.ledUntil = now() + 2500;
+}
+
+static void activityStop() {
+  ActivityState& a = s.activity;
+  if (a.running.isEmpty() || a.runningSince == 0) {
+    a.running = {Slot::Kind::Empty, 0};
+    return;
+  }
+  uint32_t seconds = (now() - a.runningSince) / 1000;
+  for (int i = 0; i < a.count; i++) {
+    if (a.entries[i].slot == a.running) {
+      a.entries[i].seconds += seconds;
+    }
+  }
+  a.totalSeconds += seconds;
+  a.running = {Slot::Kind::Empty, 0};
+  a.runningSince = 0;
+}
+
+static void activityStart(Slot slot) {
+  ActivityState& a = s.activity;
+  activityStop();
+  int i = 0;
+  while (i < a.count && !(a.entries[i].slot == slot)) {
+    i++;
+  }
+  if (i == a.count) {
+    if (a.count < ActivityState::k_entries) {
+      a.count++;
+    } else {
+      i = a.count - 1;  // forget the last one
+    }
+    a.entries[i] = {slot, 0, 0};
+  }
+  a.entries[i].launches++;
+  a.running = slot;
+  a.runningSince = now() == 0 ? 1 : now();
+}
