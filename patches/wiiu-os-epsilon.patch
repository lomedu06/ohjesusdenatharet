+#include "calc.h"
+
+#include <string.h>
+
+namespace Home {
+namespace WiiU {
+namespace Calc {
+
+namespace {
+char s_inputs[k_capacity][k_textSize];
+char s_outputs[k_capacity][k_textSize];
+uint8_t s_count = 0;
+uint8_t s_stored = 0;
+}  // namespace
+
+void push(const char* input, const char* output) {
+  int slot = s_count % k_capacity;
+  strlcpy(s_inputs[slot], input, k_textSize);
+  strlcpy(s_outputs[slot], output, k_textSize);
+  s_count++;
+  if (s_stored < k_capacity) {
+    s_stored++;
+  }
+}
+
+uint8_t count() { return s_count; }
+
+bool at(int i, const char** input, const char** output) {
+  if (i < 0 || i >= s_stored) {
+    return false;
+  }
+  int slot = (s_count - 1 - i + 256 * k_capacity) % k_capacity;
+  *input = s_inputs[slot];
+  *output = s_outputs[slot];
+  return true;
+}
+
+}  // namespace Calc
