+struct ShopItem {
+  const char* name;
+  const char* price;
+  uint8_t icon;
+};
+
+constexpr ShopItem k_shopItems[] = {
+    {"Calculatrice Turbo (DLC)", "2,99 EUR", WiiUIcons::IconCalculation},
+    {"Pack de 1000 points de maths", "0,99 EUR", WiiUIcons::IconStatistics},
+    {"Thème Wii U-OS doré", "1,49 EUR", WiiUIcons::IconSettings},
+    {"Mode triche pour contrôles", "9999 EUR", WiiUIcons::IconHealth},
+    {"Plus de mémoire RAM", "4,99 EUR", WiiUIcons::IconDownloads},
+};
+constexpr int k_numberOfShopItems = sizeof(k_shopItems) / sizeof(ShopItem);
+
+int shopCount() { return numberOfGames() + k_numberOfShopItems; }
+
+bool shopEvent(Event e) {
+  ShopState& st = s.shop;
+  if (st.message) {
+    if (e.isKeyboardEvent() && e != Events::OnOff) {
+      st.message = 0;
+      invalidateAll();
+      return true;
+    }
+    return false;
+  }
+  if (e == Events::Up && st.selected > 0) {
+    st.selected--;
+  } else if (e == Events::Down && st.selected + 1 < shopCount()) {
+    st.selected++;
+  } else if (e == Events::OK || e == Events::EXE) {
+    st.message = st.selected < numberOfGames() ? 2 : 1;
+  } else if (e == Events::Back) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
