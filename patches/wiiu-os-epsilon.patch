@@ -1,3 +1,5 @@
+#include <stdlib.h>
+#include <ion/circuit_breaker.h> // WIIUOS_TEST_HOOK
 #include "events.h"
 
 #include <SDL.h>
@@ -132,6 +134,21 @@ Event getEvent(int* timeout) {
     *timeout = 0;
     nextEvent = Ion::Events::None;
   }
+  /* WIIUOS_TEST_HOOK: behave like the device kernel on Home */
+  if (getenv("SIM_KERNEL_HOME") && nextEvent == Ion::Events::Home &&
+      Ion::CircuitBreaker::hasCheckpoint(
+          Ion::CircuitBreaker::CheckpointType::Home)) {
+    Ion::CircuitBreaker::loadCheckpoint(
+        Ion::CircuitBreaker::CheckpointType::Home);
+  }
+  /* WIIUOS_TEST_HOOK: worst case for On/Off, wake up through the Home
+   * checkpoint */
+  if (getenv("SIM_KERNEL_ONOFF") && nextEvent == Ion::Events::OnOff &&
+      Ion::CircuitBreaker::hasCheckpoint(
+          Ion::CircuitBreaker::CheckpointType::Home)) {
+    Ion::CircuitBreaker::loadCheckpoint(
+        Ion::CircuitBreaker::CheckpointType::Home);
+  }
   return nextEvent;
 }
 
