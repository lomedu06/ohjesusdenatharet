+  }
+  y -= offset;
+  char buffer[96];
+  for (int i = 0; i < m.count; i++) {
+    const Post& p = m.posts[i];
+    int h = postHeight(p);
+    Rect card = {6, y, 308, h};
+    if (card.intersects(b.clip())) {
+      if (i == m.selected) {
+        roundFill(b, card.inset(-2), 9, accent());
+      }
+      roundFill(b, card, 8, k_white);
+      roundFrame(b, card, 8, k_line);
+      roundFill(b, {card.x + 6, card.y + 6, 30, 30}, 6, rgb(0xEEF2F5));
+      Rect face = {card.x + 6, card.y + 6, 30, 30};
+      Rect saved = b.clip();
+      if (b.setClip(face.intersection(saved))) {
+        drawMiiBust(b, postAuthor(p), face.x + 15, face.y + 14, 16);
+      }
+      b.setClip(saved);
+      text(b, postAuthor(p).name, card.x + 42, card.y + 4, k_ink);
+      fmt(buffer, sizeof(buffer), "%s - il y a %d min",
+          k_communities[p.community % 7], p.minutesAgo);
+      text(b, buffer, card.x + 42 + textWidth(postAuthor(p).name) + 8,
+           card.y + 4, k_inkLight, Small, Align::Left, 200);
+      if (p.kind == 2) {
+        drawDrawing(b, card.x + 42, card.y + 22, 1, rgb(0xFFFDF2),
+                    rgb(0x3A3F45));
+        frame(b, {card.x + 41, card.y + 21, DrawingState::k_width + 2,
+                  DrawingState::k_height + 2},
+              k_line);
+      } else {
+        postText(p, buffer, sizeof(buffer));
+        paragraph(b, buffer, card.x + 42, card.y + 20, 37, k_ink, 2, 14);
+      }
+      // "Ouah !" button
+      Rect yeah = {card.right() - 58, card.bottom() - 18, 52, 15};
+      roundFill(b, yeah, 7, p.yeahed ? rgb(0x8CD21E) : rgb(0xEEF2F5));
+      tinted(b, WiiUIcons::IconYeah, yeah.x + 3, yeah.y + 1,
+             p.yeahed ? k_white : rgb(0x8CB84E));
+      fmt(buffer, sizeof(buffer), "%d", p.yeahs);
+      text(b, buffer, yeah.right() - 5, yeah.y, p.yeahed ? k_white : k_ink,
+           Small, Align::Right);
+    }
+    y += h + 4;
