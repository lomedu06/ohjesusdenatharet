+def art_code(c):
+    white_bg(c)
+    c.rrect(20, 18, 56, 52, 10, fill=hexc(0x3776AB))
+    c.rrect(44, 48, 80, 82, 10, fill=hexc(0xFFD43B))
+    c.rect(32, 40, 56, 52, fill=hexc(0x3776AB))
+    c.rect(44, 48, 68, 60, fill=hexc(0xFFD43B))
+    c.circle(30, 27, 3.5)
+    c.circle(70, 73, 3.5)
+
+
+def art_elements(c):
+    gradient_bg(c, 0xB271D6, 0x7E3CA8)
+    cols = [0xFF7A7A, 0xFFC74D, 0x7BE07B, 0x6FC7FF]
+    for j in range(4):
+        for i in range(5):
+            if j < 2 and 0 < i < 4:
+                continue
+            x = 14 + i * 15
+            y = 22 + j * 15
+            c.rrect(x, y, x + 12, y + 12, 2, fill=hexc(cols[(i + j) % 4]))
+
+
+def art_calc_settings(c):
+    gradient_bg(c, 0x9AA4AE, 0x66717C)
+    gear(c, 50, 50, 28, 0xFFFFFF)
+    c.circle(50, 50, 10, fill=hexc(0x7C8792))
+
+
+def gear(c, cx, cy, r, col):
+    pts = []
+    for i in range(48):
+        a = i / 48 * 2 * math.pi
+        rr = r if (i // 3) % 2 == 0 else r * 0.78
+        pts.append((cx + rr * math.cos(a), cy + rr * math.sin(a)))
+    c.poly(pts, fill=hexc(col))
+
+
+def mii_face(c, cx, cy, s, skin, hair, shirt):
+    c.ellipse(cx - 16 * s, cy + 14 * s, cx + 16 * s, cy + 40 * s, fill=hexc(shirt))
+    c.ellipse(cx - 13 * s, cy - 14 * s, cx + 13 * s, cy + 16 * s, fill=hexc(skin))
+    c.pie(cx, cy - 2 * s, 14 * s, 180, 360, fill=hexc(hair))
+    c.rect(cx - 14 * s, cy - 3 * s, cx - 10 * s, cy + 6 * s, fill=hexc(hair))
+    c.rect(cx + 10 * s, cy - 3 * s, cx + 14 * s, cy + 6 * s, fill=hexc(hair))
+    c.ellipse(cx - 6.5 * s, cy + 1 * s, cx - 3 * s, cy + 6 * s, fill=hexc(0x2A2A2A))
+    c.ellipse(cx + 3 * s, cy + 1 * s, cx + 6.5 * s, cy + 6 * s, fill=hexc(0x2A2A2A))
+    c.arc(cx, cy + 6 * s, 5 * s, 20, 160, 1.8 * s, fill=hexc(0xB0403A))
+
+
+def art_mii_maker(c):
+    white_bg(c)
+    mii_face(c, 28, 30, 0.75, 0xF8D2B0, 0x4A2C17, 0xE60012)
+    mii_face(c, 72, 30, 0.75, 0x8D5A3B, 0x1A1A1A, 0x2E8BFF)
+    mii_face(c, 50, 64, 0.85, 0xFCE0C4, 0xE0B040, 0x40C060)
+
+
+def art_settings(c):
+    white_bg(c)
+    # A wrench
+    g = hexc(0x8E959C)
+    c.line([(30, 72), (58, 44)], 13, fill=g)
+    c.circle(64, 36, 19, fill=g)
+    c.poly([(64, 36), (78, 14), (92, 30)], fill=CLEAR)
+    c.circle(64, 36, 6, fill=CLEAR)
+    # repaint the hole and notch with the tile white
+    c.poly([(66, 33), (78, 16), (88, 28), (70, 40)], fill=hexc(0xF4F6F8))
+    c.circle(29, 73, 3, fill=hexc(0xF4F6F8))
+
+
+def art_activity(c):
+    white_bg(c)
+    for i, h in enumerate((26, 44, 62, 36)):
+        x = 18 + i * 17
+        c.rrect(x, 82 - h, x + 13, 82, 2, fill=hexc(0x3CC23C))
+        c.rect(x + 9, 82 - h, x + 13, 82, fill=hexc(0x239A23))
+        c.ellipse(x, 79 - h, x + 13, 85 - h, fill=hexc(0x8EEA6A))
+
+
+def art_parental(c):
+    white_bg(c)
+    p = hexc(0xEE3E9A)
+    c.circle(42, 22, 9, fill=None, outline=p, width=4)
+    c.line([(42, 32), (42, 62)], 7, fill=p)
+    c.line([(24, 42), (60, 42)], 6, fill=p)
+    c.line([(42, 62), (34, 84)], 6, fill=p)
+    c.line([(42, 62), (50, 84)], 6, fill=p)
