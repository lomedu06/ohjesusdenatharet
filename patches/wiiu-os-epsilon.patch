+
+bool friendsEvent(Event e) {
+  FriendsState& f = s.friends;
+  if (f.profile) {
+    if (e == Events::Back || e == Events::OK || e == Events::EXE) {
+      f.profile = false;
+      invalidateAll();
+      return true;
+    }
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  if (e == Events::Up && f.selected > 0) {
+    f.selected--;
+  } else if (e == Events::Down && f.selected + 1 < k_numberOfFriends) {
+    f.selected++;
+  } else if (e == Events::Left && f.selected >= 2) {
+    f.selected -= 2;
+  } else if (e == Events::Right && f.selected + 2 < k_numberOfFriends) {
+    f.selected += 2;
+  } else if (e == Events::OK || e == Events::EXE) {
+    f.profile = true;
+  } else if (e == Events::Back) {
+    closeApplet();
+    return true;
+  } else {
+    return e.isKeyboardEvent() && e != Events::OnOff;
+  }
+  invalidateAll();
+  return true;
+}
