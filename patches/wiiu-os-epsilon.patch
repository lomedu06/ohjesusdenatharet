+void miiverseRender(Band& b) {
+  MiiverseState& m = s.miiverse;
+  // Green Miiverse header
+  vgradient(b, {0, k_top, k_screenWidth, 18}, rgb(0x8CD21E), rgb(0x6AB80E));
+  text(b, "Communautés : tout Miiverse", 8, k_top + 2, k_white);
+  // Scroll so that the selected post is visible
+  int y = k_top + 22;
+  int before = 0;
+  for (int i = 0; i < m.selected; i++) {
+    before += postHeight(m.posts[i]) + 4;
+  }
+  int visible = k_bottom - y - 4;
+  int offset = before + postHeight(m.posts[m.selected]) > visible
+                   ? before + postHeight(m.posts[m.selected]) - visible
+                   : 0;
+  if (!b.setClip({0, y, k_screenWidth, k_bottom - y})) {
+    b.resetClip();
+    hintBar(b, "OK : Ouah !   Boîte à outils : dessiner");
